<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/app_spacing_md"
    android:paddingBottom="@dimen/app_spacing_md">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLinkEntryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/app_text_size_md"
            android:textColor="@color/app_text_label" />

        <TextView
            android:id="@+id/tvLinkEntrySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/app_text_size_sm"
            android:textColor="@color/app_text_caption" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnLinkEntryDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_close_modern"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete link" />

</LinearLayout>
