<?xml version="1.0" encoding="utf-8"?>
<!--
  The four actions of the add button's speed dial, stacked vertically, each a small round button with
  its label on the left:

        Links    ( link )     opens the Links page (symlinks / hardlinks)
        Fork     ( split )    opens the Fork page: copy a task or group into the same group
        Clone    ( copy )     not wired yet — greyed, a tap only says so
        Task     ( pencil )   opens the regular Add Task screen   ← nearest the main button

  This is the FIRST child of activity_main's "addFabStack" (a vertical LinearLayout whose last child is
  fabAdd), so the rows are laid out ABOVE the main button by the layout itself — they can never end up
  underneath it, whatever size the button is or whether it is rotated. (An earlier version positioned
  this relative to fabAdd with a CoordinatorLayout anchor, and the bottom row landed under the button.)

  The stack is right-aligned, so the rows end at the main button's right edge; the end padding below
  centres the small buttons (40dp) over the main one (56dp), and the bottom margin is the gap above it.
  Wired in MainActivity.setSpeedDialOpen() / setupViews().

  Every container here (this one and each row) has clipChildren / clipToPadding OFF. They hug their
  children, and a container that clips cuts off its children's elevation shadows at its own edge —
  which showed as square shadows on the labels and the buttons.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/speedDial"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:layout_marginBottom="@dimen/app_spacing_md"
    android:paddingEnd="@dimen/app_spacing_md"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <!-- Links -->
    <LinearLayout
        android:id="@+id/rowSpeedDialLinks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_spacing_md"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/app_spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/app_card_padding_xs"
                android:paddingEnd="@dimen/app_card_padding_xs"
                android:paddingTop="@dimen/app_card_padding_cs"
                android:paddingBottom="@dimen/app_card_padding_cs"
                android:text="Links"
                android:textSize="@dimen/app_text_size_md"
                android:textColor="@color/app_text_body"
                android:fontFamily="sans-serif-medium" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSpeedDialLinks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_speed_dial_link"
            app:fabSize="mini"
            app:backgroundTint="@color/colorAccent"
            app:tint="@color/app_white"
            android:contentDescription="Links" />
    </LinearLayout>

    <!-- Fork — opens the Fork page -->
    <LinearLayout
        android:id="@+id/rowSpeedDialFork"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_spacing_md"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/app_spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/app_card_padding_xs"
                android:paddingEnd="@dimen/app_card_padding_xs"
                android:paddingTop="@dimen/app_card_padding_cs"
                android:paddingBottom="@dimen/app_card_padding_cs"
                android:text="Fork"
                android:textSize="@dimen/app_text_size_md"
                android:textColor="@color/app_text_body"
                android:fontFamily="sans-serif-medium" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSpeedDialFork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_speed_dial_fork"
            app:fabSize="mini"
            app:backgroundTint="@color/colorAccent"
            app:tint="@color/app_white"
            android:contentDescription="Fork" />
    </LinearLayout>

    <!-- Clone — shown, not wired yet (greyed; a tap only says so) -->
    <LinearLayout
        android:id="@+id/rowSpeedDialClone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_spacing_md"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/app_spacing_md"
            android:alpha="0.45">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/app_card_padding_xs"
                android:paddingEnd="@dimen/app_card_padding_xs"
                android:paddingTop="@dimen/app_card_padding_cs"
                android:paddingBottom="@dimen/app_card_padding_cs"
                android:text="Clone"
                android:textSize="@dimen/app_text_size_md"
                android:textColor="@color/app_text_body"
                android:fontFamily="sans-serif-medium" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSpeedDialClone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_speed_dial_clone"
            app:fabSize="mini"
            app:backgroundTint="@color/colorAccent"
            app:tint="@color/app_white"
            android:contentDescription="Clone"
            android:alpha="0.45" />
    </LinearLayout>

    <!-- Task -->
    <LinearLayout
        android:id="@+id/rowSpeedDialTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_spacing_md"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/app_spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/app_card_padding_xs"
                android:paddingEnd="@dimen/app_card_padding_xs"
                android:paddingTop="@dimen/app_card_padding_cs"
                android:paddingBottom="@dimen/app_card_padding_cs"
                android:text="Task"
                android:textSize="@dimen/app_text_size_md"
                android:textColor="@color/app_text_body"
                android:fontFamily="sans-serif-medium" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSpeedDialTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_speed_dial_task"
            app:fabSize="mini"
            app:backgroundTint="@color/colorAccent"
            app:tint="@color/app_white"
            android:contentDescription="Task" />
    </LinearLayout>

</LinearLayout>
