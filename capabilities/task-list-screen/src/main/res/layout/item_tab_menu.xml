<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of a tab's pop-up menu — the Queue (identity kinds) and Completed (modes) menus use it
  through MainActivity.showTabMenu. (The Schedule menu uses item_tab_menu_status.xml, which adds the
  status column.)

  Each menu is exactly as wide as the tab that opened it, so a row is single line and ellipsized: a
  long label is cut short rather than wrapped or allowed to widen the menu. The label is CENTRED, like
  the tab's own label, and one step above the body size (16sp, medium weight) so it reads at the tab's
  weight. Side padding is small on purpose: a centred label such as "Process Group" needs the room.
  Tokens only — no raw sp/dp.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvTabMenuLabel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/app_spacing_sm"
    android:paddingEnd="@dimen/app_spacing_sm"
    android:paddingTop="@dimen/app_card_padding_sm"
    android:paddingBottom="@dimen/app_card_padding_sm"
    android:gravity="center"
    android:textSize="@dimen/app_text_size_lg"
    android:textColor="@color/app_text_body"
    android:fontFamily="sans-serif-medium"
    android:singleLine="true"
    android:ellipsize="end" />
