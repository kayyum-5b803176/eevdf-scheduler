<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the Queue tab's identity-kind menu (see MainActivity.showQueueKindFilterMenu).

  Single line, ellipsized: the menu is exactly as wide as the Queue tab, so a long label such as
  "Process Group" is cut short rather than wrapped or allowed to widen the menu.
  Tokens only — no raw sp/dp.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/app_card_padding_sm"
    android:paddingEnd="@dimen/app_card_padding_sm"
    android:paddingTop="@dimen/app_card_padding_sm"
    android:paddingBottom="@dimen/app_card_padding_sm"
    android:textSize="@dimen/app_text_size_md"
    android:textColor="@color/app_text_body"
    android:fontFamily="sans-serif"
    android:singleLine="true"
    android:ellipsize="end" />
