<?xml version="1.0" encoding="utf-8"?>
<!--
    EXPERIMENTAL — internal to SkeletonCardView, demo-only (Layout demo
    page's existing "template" tab, alongside the 4 real templates). Not
    one of the 9 catalog templates yet; not applied to the real task card.

    Fixed slot order: 1 title, 2 subtitle, 3 metric, 4 input. Slot 4 splits
    into two separate row kinds — at most one full-width input (slider or
    the native dropdown box), and/or a row of icon-only small inputs
    (toggle, button) — never reordered relative to each other, and the
    full-input row (if present) always comes before the small-input row.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/skeletonCardRoot"
        style="@style/App.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/app_card_gap"
        android:layout_marginEnd="@dimen/app_card_gap"
        android:layout_marginTop="@dimen/app_card_gap"
        android:layout_marginBottom="@dimen/app_card_gap">

        <LinearLayout
            android:id="@+id/skeletonBody"
            style="@style/App.SettingsCard.Body"
            android:orientation="vertical">

            <!-- Slot 1 [F] — title -->
            <TextView
                android:id="@+id/skeletonTitle"
                style="@style/App.Row.Title" />

            <!-- Slot 2 [O] — subtitle / category / group -->
            <TextView
                android:id="@+id/skeletonSubtitle"
                style="@style/App.Row.Subtitle"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/app_spacing_cs"
                android:visibility="gone" />

            <!-- Slot 3 [O] — metric / changeable readout -->
            <TextView
                android:id="@+id/skeletonMetric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_spacing_sm"
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_text_body"
                android:fontFamily="monospace"
                android:visibility="gone" />

            <!-- Slot 4a [O] — full-width input: whichever single widget
                 applies (slider or the native dropdown box) is inflated
                 into this container at runtime. -->
            <FrameLayout
                android:id="@+id/skeletonFullInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_spacing_md"
                android:visibility="gone" />

            <!-- Slot 4b [O] — small, icon-only inputs. Right-aligned, in
                 sequence — see SkeletonCardView.smallInputs. -->
            <LinearLayout
                android:id="@+id/skeletonSmallInputRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_spacing_md"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</merge>
