<?xml version="1.0" encoding="utf-8"?>
<!--
  Wake prompt — set a task's scheduled wake.

  Row 0   mode:  Alarm (a calendar date + time)  |  Timer (a duration from now)
          — what each mode means is behind the info icon in the title (dialog_wake_title.xml).
  Row 1   Day | Month | Year          (alarm: the date;  timer: how long, in days / months / years)
  Row 2   Hour | Min | Sec            (alarm: the time, 24 h;  timer: how long, in hours / minutes / seconds)

  Every box takes numbers only. WakePromptDialog.kt fills and validates it.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/app_card_padding_md"
    android:paddingEnd="@dimen/app_card_padding_md"
    android:paddingTop="@dimen/app_spacing_lg">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/wakeModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWakeModeAlarm"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Alarm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWakeModeTimer"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Timer" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Row 1: Day | Month | Year -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/app_spacing_md">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/app_spacing_md"
            android:hint="Day">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWakeDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="5"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/app_spacing_md"
            android:hint="Month">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWakeMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="5"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Year">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWakeYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Row 2: Hour | Min | Sec -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/app_spacing_md">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/app_spacing_md"
            android:hint="Hour">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWakeHour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/app_spacing_md"
            android:hint="Min">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWakeMinute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="7"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Sec">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWakeSecond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="9"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</LinearLayout>
