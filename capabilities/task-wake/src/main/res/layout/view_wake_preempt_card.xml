<?xml version="1.0" encoding="utf-8"?>
<!--
  Inside of the preempt card — same structure as the timer card's expired block:
  a header (name + subtitle) and a button row. The card itself (background, corners,
  margins) is PreemptCardView, styled with App.Card in the host layout.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/app_card_padding_md">

    <TextView
        android:id="@+id/tvWakeCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wake"
        android:textColor="@android:color/white"
        android:textSize="@dimen/app_text_size_lg"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvWakeCardSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/app_white_67"
        android:textSize="@dimen/app_text_size_sm"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/app_spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWakeDismiss"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dismiss"
            android:textColor="@android:color/white"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@android:color/white"
            android:layout_marginEnd="@dimen/app_spacing_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWakePrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Preempt"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/timerGreen" />
    </LinearLayout>
</LinearLayout>
