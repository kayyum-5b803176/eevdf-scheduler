<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/app_spacing_xl"
    android:paddingEnd="@dimen/app_spacing_xl"
    android:paddingTop="@dimen/app_spacing_md"
    android:paddingBottom="@dimen/app_spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvEventLogTopic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/app_text_size_md"
            android:textStyle="bold"
            android:textColor="@color/app_text_title"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvEventLogTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_spacing_md"
            android:textSize="@dimen/app_text_size_sm"
            android:textColor="@color/app_text_hint" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvEventLogPayload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_spacing_sm"
        android:textSize="@dimen/app_text_size_sm"
        android:textColor="@color/app_text_body"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:ellipsize="end" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/app_spacing_md"
        android:background="@color/divider" />

</LinearLayout>
