<?xml version="1.0" encoding="utf-8"?>
<!--
  ACL tab — which DIRECT children of a hardlinked group this ONE placement shows.

  aclContainer          — GONE unless AddTaskActivity was opened with "membership_id"
  switchAclHideNew      — default for the group's DIRECT children that have no rule
  aclBreadcrumb         — Group › sub › sub; tap a segment to go up to that level
  tvAclLocked           — shown when the level being viewed is itself hidden
  rvAclChildren         — one row per item at this level (item_acl_child.xml):
                          name (tap to open groups) + Inherit / Hide / Show circles
  tvAclEmpty            — empty state (this level has no items)

  Header symbols: =  Inherit   -  Hide   +  Show (same order as the circles in each row).
  Multi-level: a rule can sit on any item at any depth and is inherited downward.
  Every change saves immediately through TaskRepository; there is no Save button.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aclContainer"
    style="@style/App.PageScroll"
    android:layout_height="match_parent"
    android:visibility="gone"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        style="@style/App.PageContent">

        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/app_card_padding_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hide new children by default"
                        android:textSize="@dimen/app_text_size_md"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/app_text_label" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Direct children with no rule start hidden. Deeper items follow their parent."
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_hint"
                        android:layout_marginTop="@dimen/app_spacing_cs" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAclHideNew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/app_card_padding_md">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="@dimen/app_spacing_sm">
                    <LinearLayout
                        android:id="@+id/aclBreadcrumb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvAclLocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_color_error"
                    android:layout_marginBottom="@dimen/app_spacing_md"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="=  follows the parent      -  hides the item and everything inside it through this link only      +  shows it. The item itself and its other locations are never changed."
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:layout_marginBottom="@dimen/app_spacing_md" />

                <!-- Column header: same widths as the three frames in item_acl_child.xml -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <TextView
                        android:layout_width="@dimen/acl_radio_column_width"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="="
                        android:contentDescription="Inherit"
                        android:textSize="@dimen/app_text_size_md"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/app_text_label" />
                    <TextView
                        android:layout_width="@dimen/acl_radio_column_width"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="-"
                        android:contentDescription="Hide"
                        android:textSize="@dimen/app_text_size_md"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/app_text_label" />
                    <TextView
                        android:layout_width="@dimen/acl_radio_column_width"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="+"
                        android:contentDescription="Show"
                        android:textSize="@dimen/app_text_size_md"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/app_text_label" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_divider"
                    android:background="@color/app_divider_inner"
                    android:layout_marginTop="@dimen/app_spacing_sm" />

                <TextView
                    android:id="@+id/tvAclEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This group has no children yet."
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_caption"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAclChildren"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
