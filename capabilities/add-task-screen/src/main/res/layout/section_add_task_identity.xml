<?xml version="1.0" encoding="utf-8"?>
<!--
  Identity card — replaces the old free-text Category card.

  actvIdentityKind — what this task IS: Undefined (default), User, Group, Process,
                     Thread, Process Group, Session. Read-only dropdown.
  etIdentityId     — the task's number inside that kind (UID / GID / PID / TID / PGID /
                     SID, or ID for Undefined). GENERATED, never typed: the smallest
                     free number >= 101 in the kind's own pool (1-100 are reserved for
                     the system). Read-only; changing the kind shows the new number at
                     once. tilIdentityId's hint is the number's name for the chosen kind.

  Wired in IdentitySection.kt :: setupIdentityInput().
-->
<com.google.android.material.card.MaterialCardView
    style="@style/App.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/app_card_gap"
    android:layout_marginEnd="@dimen/app_card_gap"
    android:layout_marginTop="@dimen/app_card_gap"
    android:layout_marginBottom="@dimen/app_card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/app_card_padding_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Identity"
            android:textSize="@dimen/app_text_size_md"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/app_text_label"
            android:layout_marginBottom="@dimen/app_spacing_lg" />

        <!-- Kind — floating hint, no external label -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIdentityKind"
            style="@style/App.TextInput.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kind">

            <AutoCompleteTextView
                android:id="@+id/actvIdentityKind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:cursorVisible="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ID — generated by the system, shown read-only. Its hint (PID, UID, ...) follows the kind. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIdentityId"
            style="@style/App.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_spacing_lg"
            android:hint="ID">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIdentityId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:cursorVisible="false"
                android:longClickable="false"
                android:maxLines="1"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
