<?xml version="1.0" encoding="utf-8"?>
<!--
  Add / Edit Task screen.

  This file owns only the chrome (AppBar + scroll container).
  Each form card lives in its own section file:

    section_add_task_detail.xml         — Task name, description, parent group
    section_add_task_timeslice.xml      — HH / MM / SS time-slice inputs
    section_add_task_priority.xml       — Priority slider + band description
    section_add_task_tasktype.xml       — Task type, group/interrupt switches, notice fields
    section_add_task_realtimeshare.xml  — Realtime share toggle + pinned-% field
    section_add_task_quota.xml          — Quota limit toggle + quota/period fields
    section_add_task_sleep.xml          — Sleep duration (moon button) text field
    section_add_task_scheduler.xml      — Scheduler class toggle + DL + RT sub-sections
    section_add_task_category.xml       — Category chip group
    section_add_task_buttons.xml        — Save / Cancel action buttons
    section_add_task_acl.xml            — ACL tab (hardlink placements only): hidden direct children

  The tab bar and the ACL container are GONE unless the screen was opened from a
  hardlink row (intent extra "membership_id"). Tabs only toggle visibility of
  @id/configScroll (the unchanged form) and @id/aclContainer.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screenBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/app_text_label"
            app:titleTextColor="@android:color/white" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabAddTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_text_label"
            android:visibility="gone"
            app:tabTextColor="#B3FFFFFF"
            app:tabSelectedTextColor="@android:color/white"
            app:tabIndicatorColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/configScroll"
        style="@style/App.PageScroll"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            style="@style/App.PageContent">

            <include layout="@layout/section_add_task_detail" />
            <include layout="@layout/section_add_task_timeslice" />
            <include layout="@layout/section_add_task_priority" />
            <include layout="@layout/section_add_task_loadfactor" />
            <include layout="@layout/section_add_task_tasktype" />
            <include layout="@layout/section_add_task_taskconfig" />
            <include layout="@layout/section_add_task_realtimeshare" />
            <include layout="@layout/section_add_task_quota" />
            <include layout="@layout/section_add_task_sleep" />
            <include layout="@layout/section_add_task_scheduler" />
            <include layout="@layout/section_add_task_category" />
            <include layout="@layout/section_add_task_buttons" />

            <!-- Bottom breathing room so the Save button clears the soft keyboard -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_btn_tag" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/section_add_task_acl" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
