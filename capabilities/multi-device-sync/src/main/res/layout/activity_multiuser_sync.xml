<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/multiUserSyncToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />


    <ScrollView
        style="@style/App.PageScroll">

        <LinearLayout
            style="@style/App.PageContent">

            <!-- ── Enable toggle ────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/app_spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable Multiuser Sync"
                        android:textSize="@dimen/app_text_size_lg"
                        android:textColor="@color/app_text_title"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Share tasks, timers and history with the other users of this phone"
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_cs" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSyncEnable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ── Divider ───────────────────────────────────────────────────── -->


            <!-- ── Sync status line ──────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sync disabled"
                android:textSize="@dimen/app_text_size_md"
                android:textColor="@color/app_text_body"
                android:layout_marginBottom="@dimen/app_spacing_xl" />

            <!-- ── Folder row (hidden when sync disabled) ────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutSyncFolderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sync Folder"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_title"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Every user chooses the same folder on the SD card."
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_body"
                    android:layout_marginBottom="@dimen/app_spacing_md" />

                <!-- Current folder path display -->
                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/app_card_padding_lg">

                        <ImageView
                            android:layout_width="@dimen/app_icon_sm"
                            android:layout_height="@dimen/app_icon_sm"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:layout_marginEnd="@dimen/app_spacing_md"
                            android:tint="@color/textSecondary" />

                        <TextView
                            android:id="@+id/tvSyncFolderPath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No folder selected"
                            android:textSize="@dimen/app_text_size_md"
                            android:textColor="@color/app_text_title"
                            android:singleLine="true"
                            android:ellipsize="start" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickSyncFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/app_spacing_md"
                    android:text="Choose Sync Folder"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <!-- ── Another phone (Bluetooth) ─────────────────────────────── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_divider"
                    android:background="@color/divider"
                    android:layout_marginTop="@dimen/app_spacing_md"
                    android:layout_marginBottom="@dimen/app_spacing_xl" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Another phone (Bluetooth)"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_title"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/App.Card"
                    android:id="@+id/cardBluetooth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/app_card_padding_lg">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchBluetooth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sync with another phone"
                            android:textSize="@dimen/app_text_size_md"
                            android:textColor="@color/app_text_body" />

                        <TextView
                            android:id="@+id/tvBluetoothPeer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/app_spacing_sm"
                            android:text="No phone chosen"
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/app_text_body" />

                        <TextView
                            android:id="@+id/tvBluetoothStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/app_spacing_sm"
                            android:text=""
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/textSecondary"
                            android:lineSpacingMultiplier="1.3" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChoosePhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/app_spacing_sm"
                            android:text="Choose the other phone"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/app_spacing_sm"
                            android:text="Pair the two phones in Android's Bluetooth settings first, then choose each phone on the other. Both phones need this app open; they exchange changes about once a minute and on Sync Now."
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/textSecondary"
                            android:lineSpacingMultiplier="1.3" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── Details card ──────────────────────────────────────────── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_divider"
                    android:background="@color/divider"
                    android:layout_marginTop="@dimen/app_spacing_md"
                    android:layout_marginBottom="@dimen/app_spacing_xl" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Details"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_title"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/App.Card"
                    android:id="@+id/cardSyncDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">

                    <TextView
                        android:id="@+id/tvSyncDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/app_card_padding_lg"
                        android:text=""
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:lineSpacingMultiplier="1.3" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ── Sync Now button (also hidden when disabled) ───────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sync Now"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- ── How it works info ─────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_divider"
                android:background="@color/divider"
                android:layout_marginTop="@dimen/app_spacing_cl"
                android:layout_marginBottom="@dimen/app_spacing_xl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Each user keeps their own data. Only small notes about what changed are written to the SD card, so the card sees very little wear.\n\n• Open the app and it catches up by itself. Start a timer in one user, stop it in another.\n\n• A new or empty user can never erase the others: it can only add.\n\n• If the card is missing, the app keeps working. Your changes wait and are written when the card is back.\n\n• First time: update the app in every user, then switch sync on FIRST in the user whose data is most up to date."
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_text_body"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
