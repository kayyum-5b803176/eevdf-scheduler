<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_size_input"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="@color/screenBackground"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select Parent Group"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <!-- Path mode switch: shown only when the caller offers it -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPickerPath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Path"
            android:textSize="13sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnPickerClose"
            android:layout_width="40dp"
            android:layout_height="@dimen/app_size_calendar_row"
            android:padding="8dp"
            android:src="@drawable/ic_close_modern"
            android:tint="#616161"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />

    </LinearLayout>

    <!-- Search field -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:hint="Search groups…"
        app:startIconDrawable="@drawable/ic_search_modern"
        app:startIconTint="#9E9E9E"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etGroupSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Axis chips: which axis's groups are listed (only when the caller offers axes) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupPickerAxis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:singleSelection="true"
        app:selectionRequired="true" />

    <TextView
        android:id="@+id/tvPickerAxisHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:textSize="12sp"
        android:textColor="#757575"
        android:visibility="gone" />

    <!-- Group list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGroupItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:nestedScrollingEnabled="true"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay" />

    <!-- Path mode footer: where the task will exist, and Done -->
    <LinearLayout
        android:id="@+id/layoutPickerPathFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPickerPathSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="14sp"
            android:textColor="#212121" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnPickerPathCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel" />

            <Button
                android:id="@+id/btnPickerPathDone"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
