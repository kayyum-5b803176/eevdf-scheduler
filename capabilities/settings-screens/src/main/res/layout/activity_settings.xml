<?xml version="1.0" encoding="utf-8"?>
<!--
    Text casing: all labels and descriptions are lowercase.
    Abbreviations and acronyms stay uppercase (UI, API, ID, EEVDF, SI, DL, RT).
    See docs/UI_TEXT_CONVENTIONS.md for the full rule and checklist.

    RESOLVED (typed-entity + centralized-renderer redesign): this used to
    declare each row as a <com.eevdf.capabilities.designsystem.output.NavCardView>
    XML tag directly — itself a construction reference to a design-system
    output class living in this capability's own resources, which the
    redesign's rule 3 doesn't allow. The four tab-content LinearLayouts
    below are now plain, empty containers; SettingsActivity.kt populates
    each with NavCardView instances built via renderNavCard(NavCardEntity)
    and addView(), in the same order these tags used to appear. No
    inter-card divider views: each NavCardView's own outer margin
    (CardDensity.applyOuterGap, live-token-driven) is what separates
    cards, uniformly, the same mechanism controlling every other card in
    the app — a static divider view here would add an untracked,
    non-uniform extra gap on top of it.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/settingsTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />

    <ScrollView
        style="@style/App.PageScroll"
        android:id="@+id/settingsScrollView">

        <LinearLayout style="@style/App.PageContent">

            <!-- TAB: platform — populated by SettingsActivity.bindCards() -->
            <LinearLayout
                android:id="@+id/tabContentPlatform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible" />

            <!-- TAB: app — populated by SettingsActivity.bindCards() -->
            <LinearLayout
                android:id="@+id/tabContentApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- TAB: core — populated by SettingsActivity.bindCards() -->
            <LinearLayout
                android:id="@+id/tabContentCore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- TAB: data — populated by SettingsActivity.bindCards() -->
            <LinearLayout
                android:id="@+id/tabContentData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
