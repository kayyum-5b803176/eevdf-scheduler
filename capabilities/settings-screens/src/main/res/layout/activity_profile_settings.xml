<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/profileSettingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/profileTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />

    <ScrollView style="@style/App.PageScroll">

        <LinearLayout style="@style/App.PageContent">

            <!-- Timer sound -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">
                <LinearLayout style="@style/App.SettingsCard.Body">
                    <LinearLayout style="@style/App.Row.Value.Flush">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title" android:text="Timer Sound" />
                            <TextView
                                android:id="@+id/tvProfileSoundName"
                                style="@style/App.Row.Subtitle"
                                android:text="System alarm tone" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProfilePickSound"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Choose"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sound timeout — RESOLVED: was a hand-authored label+value+
                 slider+caption row duplicating ValueCardView's layout. Now
                 an empty container, populated via
                 renderValueCard(ValueCardEntity) in Kotlin. -->
            <FrameLayout
                android:id="@+id/soundTimeoutContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Default volume — same resolution as above. -->
            <FrameLayout
                android:id="@+id/volumeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Gradual volume increase — same resolution as above. -->
            <FrameLayout
                android:id="@+id/fadeInContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View style="@style/App.Divider.Section" />

            <!-- Vibration pattern spinner — RESOLVED: was a hand-authored
                 title+AutoCompleteTextView+button card duplicating
                 DropdownCardView's layout. Now an empty container,
                 populated via renderDropdownCard(DropdownCardEntity). -->
            <FrameLayout
                android:id="@+id/vibPatternContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Vibration timeout — same resolution as the other ValueCards. -->
            <FrameLayout
                android:id="@+id/vibTimeoutContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ══ ACTION (Notice profile only) ══════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutActionSection"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View style="@style/App.Divider.Section" />

                <!-- Execute sound -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                    <LinearLayout style="@style/App.SettingsCard.Body">
                        <LinearLayout style="@style/App.Row.Value.Flush">
                            <LinearLayout style="@style/App.Row.TextBlock">
                                <TextView style="@style/App.Row.Title" android:text="Execute Sound" />
                                <TextView
                                    android:id="@+id/tvExecuteSoundName"
                                    style="@style/App.Row.Subtitle"
                                    android:text="System notification tone" />
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPickExecuteSound"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Choose"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        </LinearLayout>
                        <TextView style="@style/App.SwitchRow.Description"
                            android:text="Played once when execute time starts"
                            android:layout_marginTop="@dimen/app_spacing_md" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Wait sound -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                    <LinearLayout style="@style/App.SettingsCard.Body">
                        <LinearLayout style="@style/App.Row.Value.Flush">
                            <LinearLayout style="@style/App.Row.TextBlock">
                                <TextView style="@style/App.Row.Title" android:text="Wait Sound" />
                                <TextView
                                    android:id="@+id/tvWaitSoundName"
                                    style="@style/App.Row.Subtitle"
                                    android:text="System notification tone" />
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPickWaitSound"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Choose"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        </LinearLayout>
                        <TextView style="@style/App.SwitchRow.Description"
                            android:text="Played once when wait time begins"
                            android:layout_marginTop="@dimen/app_spacing_md" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action volume — same resolution as the other ValueCards. -->
                <FrameLayout
                    android:id="@+id/actionVolumeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout><!-- end layoutActionSection -->

        </LinearLayout>
    </ScrollView>
</LinearLayout>
