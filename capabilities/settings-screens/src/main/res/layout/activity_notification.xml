<?xml version="1.0" encoding="utf-8"?>
<!--
    Text casing: all labels and descriptions are lowercase in the title case
    conventions used elsewhere; see docs/UI_TEXT_CONVENTIONS.md.

    Same page skeleton as every other settings screen (Toolbar + TabLayout +
    ScrollView/PageContent) — the TabLayout is present but left blank (no
    tabs added in NotificationSettingsActivity), matching ButtonActionActivity.

    Permission/capability status for these two features lives on the
    Permissions page now, not here — this page only owns the two feature
    preferences themselves.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/notificationToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />

    <ScrollView style="@style/App.PageScroll">

        <LinearLayout style="@style/App.PageContent">

            <!-- ══ LOCK SCREEN OVERLAY ══════════════════════════════════════ -->
            <!--
              RESOLVED (typed-entity + centralized-renderer redesign): was a
              hand-authored MaterialCardView duplicating ToggleCardView's
              internal layout. Now a plain, empty container —
              NotificationSettingsActivity.kt populates it via
              renderToggleCard(ToggleCardEntity).
            -->
            <FrameLayout
                android:id="@+id/lockScreenOverlayContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ══ EXCLUDE APP ══════════════════════════════════════════════ -->
            <!--
              RESOLVED: the row itself (title/subtitle/chevron/tap-to-open)
              was a hand-authored NavCard lookalike; now a real NavCard via
              renderNavCard(NavCardEntity). The explanatory description text
              below it stays plain — NavCard has no third text piece for it,
              same as the redesign's "don't force a mismatched piece into a
              template" rule.
            -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout style="@style/App.SettingsCard.Body">

                    <FrameLayout
                        android:id="@+id/excludeAppCardContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView style="@style/App.SwitchRow.Description"
                        android:layout_marginTop="@dimen/app_spacing_md"
                        android:text="The banner notification is not shown while one of the selected apps is in the foreground. Only applies to the banner style — never the lock screen overlay."
                        android:lineSpacingMultiplier="1.3" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
