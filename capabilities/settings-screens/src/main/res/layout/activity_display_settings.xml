<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/displaySettingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />


    <ScrollView style="@style/App.PageScroll">

        <LinearLayout style="@style/App.PageContent">

            <!-- ══ TAB: ui ══════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/tabContentUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

            <!-- ══ APPEARANCE ═════════════════════════════════════════════ -->

            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout style="@style/App.SettingsCard.Body">

                    <TextView style="@style/App.SwitchRow"
                        android:text="Dark Mode" />

                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="Choose between light theme, dark theme, or follow the system setting."
                        android:layout_marginBottom="@dimen/app_spacing_xl" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/darkModeToggleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDarkModeLight"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDarkModeDark"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dark" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDarkModeSystem"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="System" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ SIMPLE MODE ═════════════════════════════════════════════ -->
            <View style="@style/App.Divider.Section" />

            <!--
              RESOLVED (typed-entity + centralized-renderer redesign): was a
              hand-authored MaterialCardView duplicating ToggleCardView's
              internal layout. Now a plain, empty container —
              DisplaySettingsActivity.kt populates it via
              renderToggleCard(ToggleCardEntity).
            -->
            <FrameLayout
                android:id="@+id/simpleModeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ══ UNIT FORMAT ══════════════════════════════════════════════ -->
            <View style="@style/App.Divider.Section" />

            <FrameLayout
                android:id="@+id/unitFormatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ══ WINDOW CALIBRATE ═════════════════════════════════════════ -->
            <View style="@style/App.Divider.Section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout style="@style/App.SettingsCard.Body">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoAdjust"
                        style="@style/App.SwitchRow"
                        android:text="Window Calibrate" />

                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="Hides stat rows on FLOAT / MINI profiles. NORMAL keeps full layout." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/app_divider"
                        android:layout_marginTop="@dimen/app_spacing_lg"
                        android:layout_marginBottom="@dimen/app_spacing_lg"
                        android:background="@color/divider" />

                    <!-- Live window stats -->
                    <TextView
                        android:id="@+id/tvWindowLiveStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="reading…"
                        android:textSize="@dimen/app_text_size_xs"
                        android:textColor="@color/quotaTextExceeded"
                        android:fontFamily="monospace"
                        android:background="@color/infoBoxBackground"
                        android:paddingStart="@dimen/app_spacing_md"
                        android:paddingEnd="@dimen/app_spacing_md"
                        android:paddingTop="@dimen/app_spacing_sm"
                        android:paddingBottom="@dimen/app_spacing_sm" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/app_divider"
                        android:layout_marginTop="@dimen/app_spacing_lg"
                        android:layout_marginBottom="@dimen/app_spacing_lg"
                        android:background="@color/divider" />

                    <!-- Calibrate Profiles header -->
                    <TextView style="@style/App.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CALIBRATE PROFILES"
                        android:layout_marginBottom="@dimen/app_spacing_md" />

                    <!-- 3-column profile picker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- FLOAT profile card -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/App.Card"
                            android:id="@+id/cardCalFloat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="@dimen/app_card_gap"
                            android:layout_marginEnd="@dimen/app_card_gap"
                            android:layout_marginTop="@dimen/app_card_gap"
                            android:layout_marginBottom="@dimen/app_card_gap">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="@dimen/app_card_padding_sm">
                                <TextView style="@style/App.Text.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="FLOAT" />
                                <TextView
                                    android:id="@+id/tvCalFloatDims"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="not set"
                                    android:textSize="@dimen/app_text_size_xs"
                                    android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- NORMAL profile card -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/App.Card"
                            android:id="@+id/cardCalNormal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="@dimen/app_card_gap"
                            android:layout_marginEnd="@dimen/app_card_gap"
                            android:layout_marginTop="@dimen/app_card_gap"
                            android:layout_marginBottom="@dimen/app_card_gap">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="@dimen/app_card_padding_sm">
                                <TextView style="@style/App.Text.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NORMAL" />
                                <TextView
                                    android:id="@+id/tvCalNormalDims"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="not set"
                                    android:textSize="@dimen/app_text_size_xs"
                                    android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- MINI profile card -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/App.Card"
                            android:id="@+id/cardCalMini"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="@dimen/app_card_gap"
                            android:layout_marginEnd="@dimen/app_card_gap"
                            android:layout_marginTop="@dimen/app_card_gap"
                            android:layout_marginBottom="@dimen/app_card_gap">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="@dimen/app_card_padding_sm">
                                <TextView style="@style/App.Text.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MINI" />
                                <TextView
                                    android:id="@+id/tvCalMiniDims"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="not set"
                                    android:textSize="@dimen/app_text_size_xs"
                                    android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Hint -->
                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="Tap to record · Long-press to clear"
                        android:layout_marginTop="@dimen/app_spacing_md" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout><!-- end tabContentUi -->

            <!-- ══ TAB: render ══════════════════════════════════════════════
                 A card list, same pattern as the main Settings page. Each
                 card here navigates to its own sub-screen. If this list is
                 ever empty, the tab shows a genuinely blank content area —
                 no placeholder message, no empty-state illustration.
            ══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/tabContentRender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- NavCard: Layout — (0). RESOLVED: was a hand-authored row
                     inside a MaterialCardView; now an empty container,
                     populated via renderNavCard(NavCardEntity) in Kotlin. -->
                <FrameLayout
                    android:id="@+id/layoutDemoCardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- NavCard: Color — (0). Same resolution as above. -->
                <FrameLayout
                    android:id="@+id/colorMatrixCardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout><!-- end tabContentRender -->

        </LinearLayout>
    </ScrollView>
</LinearLayout>
