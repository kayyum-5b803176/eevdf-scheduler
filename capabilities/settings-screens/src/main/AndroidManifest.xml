<?xml version="1.0" encoding="utf-8"?>
<!-- Per-capability manifest fragment; AGP merges these at build time. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.eevdf.capabilities.settingsscreens.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.eevdf.capabilities.tasklistscreen.MainActivity" />

        <activity
            android:name="com.eevdf.capabilities.settingsscreens.ProfileSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.eevdf.capabilities.settingsscreens.SoundVibrationActivity" />

        <activity
            android:name="com.eevdf.capabilities.settingsscreens.SoundVibrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.eevdf.capabilities.settingsscreens.SettingsActivity" />

        <activity
            android:name="com.eevdf.capabilities.settingsscreens.DisplaySettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:parentActivityName="com.eevdf.capabilities.settingsscreens.SettingsActivity" />

        <activity
            android:name="com.eevdf.capabilities.settingsscreens.LayoutDemoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.eevdf.capabilities.settingsscreens.DisplaySettingsActivity" />

        <activity
            android:name="com.eevdf.capabilities.settingsscreens.ColorMatrixActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.eevdf.capabilities.settingsscreens.DisplaySettingsActivity" />

        <activity
            android:name="com.eevdf.capabilities.settingsscreens.ButtonActionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.eevdf.capabilities.settingsscreens.SettingsActivity" />

        <activity
            android:name="com.eevdf.capabilities.settingsscreens.NotificationSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.eevdf.capabilities.settingsscreens.SettingsActivity" />

        <activity
            android:name="com.eevdf.capabilities.settingsscreens.PermissionsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName="com.eevdf.capabilities.settingsscreens.SettingsActivity" />

        <activity
            android:name="com.eevdf.capabilities.settingsscreens.HardwareKeyActionActivity"
            android:exported="false"
            android:parentActivityName="com.eevdf.capabilities.settingsscreens.ButtonActionActivity" />

        <activity
            android:name="com.eevdf.capabilities.settingsscreens.HardwareKeyOptionActivity"
            android:exported="false"
            android:parentActivityName="com.eevdf.capabilities.settingsscreens.HardwareKeyActionActivity" />
    </application>
</manifest>
