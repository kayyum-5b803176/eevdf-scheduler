<?xml version="1.0" encoding="utf-8"?>
<!--
    Text casing: all labels and descriptions are lowercase.
    Abbreviations and acronyms stay uppercase (UI, API, ID, EEVDF, SI, DL, RT).
    See docs/UI_TEXT_CONVENTIONS.md for the full rule and checklist.

    MIGRATED onto NavCardView (see ARCHITECTURE.md's "universal adoption"
    phase): every card below is a single <com.eevdf.feature.ui.NavCardView>
    tag, not hand-authored MaterialCardView boilerplate. title/subtitle/
    navigable/onNavigate are set in SettingsActivity.kt, not as XML
    attributes — NavCardView has no custom attrs defined, only Kotlin
    properties, matching how the Layout demo page already builds these same
    instances via NavCardView.create(). No inter-card divider views: each
    NavCardView's own outer margin (CardDensity.applyOuterGap, live-token-
    driven since Phase 8) is now what separates cards, uniformly, the same
    mechanism controlling every other card in the app — a static divider
    view here would add an untracked, non-uniform extra gap on top of it.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/settingsTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />

    <ScrollView
        style="@style/App.PageScroll"
        android:id="@+id/settingsScrollView">

        <LinearLayout style="@style/App.PageContent">

            <!-- TAB: platform -->
            <LinearLayout
                android:id="@+id/tabContentPlatform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowVisual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowSoundVibration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- TAB: app -->
            <LinearLayout
                android:id="@+id/tabContentApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowButtonAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowEventHandleService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowAutoSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- TAB: core -->
            <LinearLayout
                android:id="@+id/tabContentCore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowSystemConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowCoreAlgorithm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowRules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- TAB: data -->
            <LinearLayout
                android:id="@+id/tabContentData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowDataBackup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowMultiUserSync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.eevdf.feature.ui.NavCardView
                    android:id="@+id/rowAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
