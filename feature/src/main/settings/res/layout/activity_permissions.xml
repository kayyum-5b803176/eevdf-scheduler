<?xml version="1.0" encoding="utf-8"?>
<!--
    Single source of truth, in the UI, for every permission/capability this
    app relies on. Same page skeleton as every other settings screen
    (Toolbar + blank TabLayout + ScrollView/PageContent).

    One card, one row per permission, so the whole list reads like a single
    checklist rather than a wall of separate cards. Status text color and
    wording are set at runtime in PermissionsActivity from
    AlarmReliabilityChecker — the single shared source of truth for the
    actual grant state, so this screen can never silently disagree with
    what the service itself would see.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/permissionsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />

    <ScrollView style="@style/App.PageScroll">

        <LinearLayout style="@style/App.PageContent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:text="Everything below affects how reliably timers alert you — especially the full-screen alarm overlay. Tap any row to fix it."
                android:textColor="@color/app_text_body"
                android:lineSpacingMultiplier="1.3" />

            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout
                    android:id="@+id/permissionListContainer"
                    style="@style/App.SettingsCard.Body"
                    android:orientation="vertical" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
