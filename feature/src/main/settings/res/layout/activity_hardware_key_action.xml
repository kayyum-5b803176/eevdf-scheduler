<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/hwKeyActionToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <ScrollView style="@style/App.PageScroll">

        <LinearLayout style="@style/App.PageContent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_spacing_lg"
                android:text="Choose what each hardware key does when a timer expires and the alarm is ringing. An action can be assigned to only one key."
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_text_body"
                android:lineSpacingMultiplier="1.3" />

            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Volume Up -->
                    <LinearLayout
                        android:id="@+id/rowVolumeUp"
                        style="@style/App.Row.Value">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="Volume Up" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvVolumeUpValue"
                            style="@style/App.Row.ValueText"
                            android:text="None" />
                    </LinearLayout>

                    <View style="@style/App.Divider" />

                    <!-- Volume Down -->
                    <LinearLayout
                        android:id="@+id/rowVolumeDown"
                        style="@style/App.Row.Value">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="Volume Down" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvVolumeDownValue"
                            style="@style/App.Row.ValueText"
                            android:text="None" />
                    </LinearLayout>

                    <View style="@style/App.Divider" />

                    <!-- Power -->
                    <LinearLayout
                        android:id="@+id/rowPower"
                        style="@style/App.Row.Value">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="Power Button" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvPowerValue"
                            style="@style/App.Row.ValueText"
                            android:text="None" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_spacing_lg"
                android:text="Note: on most devices the Power button cannot be intercepted by an app while the screen is on; Volume keys are the reliable choice."
                android:textSize="@dimen/app_text_size_xs"
                android:textColor="@color/app_text_body"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
