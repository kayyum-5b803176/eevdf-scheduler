<?xml version="1.0" encoding="utf-8"?>
<!--
  Load Factor card — human effort model, three NASA-TLX sliders.

  ── Layout structure ─────────────────────────────────────────────────────────
  Row 1 (always visible): "Load Factor" title/subtitle + toggle switch
  Row 2 (always visible): "(auto)" badge (left) | spacer | "Combined Load: X / 100" (right)
  Row 3 (only when ON):   divider + three material sliders (Cognitive, Physical, Emotional)

  Combined Load is always visible so the user can see the inherited or live
  value without enabling the toggle.  The (auto) badge sits left of the
  combined load value and disappears when the toggle is enabled manually.

  ── When disabled (inherited) ────────────────────────────────────────────────
    | Load Factor                      [switch] |
    | (auto)          Combined Load: 50 / 100   |

  ── When enabled (manual) ────────────────────────────────────────────────────
    | Load Factor                      [switch] |
    |                 Combined Load: 67 / 100   |
    | ─────────────────────────────────────────  |
    | Cognitive                              6   |
    | [══════════════○══════════]               |
    | Physical                               5   |
    | [═══════════════════○═════]               |
    | Emotional                              4   |
    | [═══════════════○═════════]               |
-->
<com.google.android.material.card.MaterialCardView
    style="@style/App.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/app_card_gap"
    android:layout_marginEnd="@dimen/app_card_gap"
    android:layout_marginTop="@dimen/app_card_gap"
    android:layout_marginBottom="@dimen/app_card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/app_card_padding_md">

        <!-- ── Row 1: title + switch ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLoadFactorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Load Factor"
                    android:textSize="@dimen/app_text_size_md"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/app_text_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_spacing_cs"
                    android:text="Human effort while this task runs"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLoadFactorEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- ── Row 2: (auto) badge + combined load — always visible ──────── -->
        <!--
             Left:   tvLoadFactorAutoLabel  — visible when inherited, GONE when manual
             Middle: spacer (weight=1)
             Right:  tvLoadFactorCombined   — always visible, updates live
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/app_spacing_md">

            <TextView
                android:id="@+id/tvLoadFactorAutoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(auto)"
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_text_body"
                android:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLoadFactorCombined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Combined Load: 50 / 100"
                android:textSize="@dimen/app_text_size_md"
                android:textColor="@color/app_text_label"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- ── Row 3: sliders — shown only when toggle is ON ─────────────── -->
        <LinearLayout
            android:id="@+id/layoutLoadFactorSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/app_spacing_lg"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_divider"
                android:background="@color/app_divider_inner"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <!-- ── Cognitive ─────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/app_spacing_cs">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cognitive"
                        android:textSize="@dimen/app_text_size_md"
                        android:textColor="@color/app_text_title"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mental concentration, analysis, decisions"
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_hint"
                        android:layout_marginTop="@dimen/app_spacing_xs" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCognitiveValue"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="@dimen/app_text_size_lg"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/app_text_label"
                    android:gravity="end" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCognitive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/app_spacing_lg"
                android:valueFrom="1"
                android:valueTo="7"
                android:stepSize="1"
                android:value="4"
                app:labelBehavior="gone" />

            <!-- ── Physical ──────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/app_spacing_cs">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Physical"
                        android:textSize="@dimen/app_text_size_md"
                        android:textColor="@color/app_text_title"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bodily exertion, movement, stamina"
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_hint"
                        android:layout_marginTop="@dimen/app_spacing_xs" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPhysicalValue"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="@dimen/app_text_size_lg"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/app_text_label"
                    android:gravity="end" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPhysical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/app_spacing_lg"
                android:valueFrom="1"
                android:valueTo="7"
                android:stepSize="1"
                android:value="4"
                app:labelBehavior="gone" />

            <!-- ── Emotional ──────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/app_spacing_cs">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emotional"
                        android:textSize="@dimen/app_text_size_md"
                        android:textColor="@color/app_text_title"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Stress, stakes, pressure, emotional weight"
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_hint"
                        android:layout_marginTop="@dimen/app_spacing_xs" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmotionalValue"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="@dimen/app_text_size_lg"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/app_text_label"
                    android:gravity="end" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderEmotional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/app_spacing_sm"
                android:valueFrom="1"
                android:valueTo="7"
                android:stepSize="1"
                android:value="4"
                app:labelBehavior="gone" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
