<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTask"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/app_card_gap"
    android:layout_marginEnd="@dimen/app_card_gap"
    android:layout_marginTop="@dimen/app_card_gap"
    android:layout_marginBottom="@dimen/app_card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Running indicator bar -->
        <View
            android:id="@+id/viewRunningIndicator"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/colorAccent"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/layoutCardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/app_card_padding_sm">

            <!-- Row 1: Rank + Name + Category + Priority badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#1"
                    android:textSize="@dimen/app_text_size_md"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/app_text_label"
                    android:layout_marginEnd="@dimen/app_spacing_md"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTaskName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task Name"
                        android:textSize="@dimen/app_text_size_lg"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/app_text_title"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="General"
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_marginStart="@dimen/app_spacing_md">

                    <TextView
                        android:id="@+id/tvPriority"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Priority: 5/10"
                        android:textSize="@dimen/app_text_size_sm"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Pill timer (DL) + Quota timer share this row.
                         Both are gone by default; adapter shows one, both, or neither. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical"
                        android:layout_marginTop="@dimen/app_spacing_cs">

                        <!-- SCHED_DEADLINE budget pill — visible only for dl_sched_class tasks -->
                        <TextView
                            android:id="@+id/tvDlStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DL"
                            android:textSize="@dimen/app_text_size_xs"
                            android:textColor="@color/cardBackground"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="@dimen/app_spacing_md"
                            android:paddingEnd="@dimen/app_spacing_md"
                            android:paddingTop="@dimen/app_spacing_cs"
                            android:paddingBottom="@dimen/app_spacing_cs"
                            android:background="@drawable/bg_dl_badge"
                            android:gravity="center"
                            android:visibility="gone" />

                        <!-- SCHED_RT window pill — visible only for rt_sched_class tasks -->
                        <TextView
                            android:id="@+id/tvRtStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RT"
                            android:textSize="@dimen/app_text_size_xs"
                            android:textColor="@color/cardBackground"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="@dimen/app_spacing_md"
                            android:paddingEnd="@dimen/app_spacing_md"
                            android:paddingTop="@dimen/app_spacing_cs"
                            android:paddingBottom="@dimen/app_spacing_cs"
                            android:layout_marginStart="@dimen/app_spacing_sm"
                            android:background="@drawable/bg_rt_badge"
                            android:gravity="center"
                            android:visibility="gone" />

                        <!-- Quota remaining — shown when quota is enabled -->
                        <TextView
                            android:id="@+id/tvQuotaRemaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="@dimen/app_text_size_xs"
                            android:textColor="@color/app_text_body"
                            android:layout_marginStart="@dimen/app_spacing_sm"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Progress bar (default — all task types except NOTIFICATION) -->
            <ProgressBar
                android:id="@+id/progressTask"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_bar_notice"
                android:layout_marginTop="@dimen/app_spacing_md"
                android:layout_marginBottom="@dimen/app_spacing_cs"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/colorPrimary"
                android:progressBackgroundTint="@color/divider" />

            <!-- Segmented progress bar — NOTIFICATION type only.
                 Segments are built programmatically in TaskAdapter.buildNoticeSegments().
                 Same height and margins as progressTask so the card layout is unchanged.
                 Visibility toggled by the adapter: VISIBLE for NOTIFICATION, GONE otherwise. -->
            <LinearLayout
                android:id="@+id/progressNotice"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_bar_notice"
                android:layout_marginTop="@dimen/app_spacing_md"
                android:layout_marginBottom="@dimen/app_spacing_cs"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone" />

            <!-- Quota usage bar — visible only when quota is enabled for this task/group -->
            <ProgressBar
                android:id="@+id/progressQuota"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_bar_track"
                android:layout_marginTop="@dimen/app_spacing_md"
                android:layout_marginBottom="@dimen/app_spacing_sm"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/app_orange_nd"
                android:progressBackgroundTint="@color/divider"
                android:visibility="gone" />

            <!-- Row 2: Time info -->
            <LinearLayout
                android:id="@+id/rowTimeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/app_spacing_sm">

                <TextView
                    android:id="@+id/tvTimeSlice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TRT: 0s"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_body" />

                <TextView
                    android:id="@+id/tvRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25:00"
                    android:textSize="@dimen/app_text_size_md"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/app_text_label"
                     />
            </LinearLayout>

            <!-- Row 3: EEVDF metrics -->
            <LinearLayout
                android:id="@+id/rowEevdfMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/app_spacing_sm">

                <TextView
                    android:id="@+id/tvVruntime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VRT: 0.00"
                    android:textSize="@dimen/app_text_size_xs"
                    android:textColor="@color/app_text_caption" />

                <TextView
                    android:id="@+id/tvVdeadline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VDL: 0.00"
                    android:textSize="@dimen/app_text_size_xs"
                    android:textColor="@color/app_text_caption" />

                <TextView
                    android:id="@+id/tvCpuShare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RS: 0.0"
                    android:textSize="@dimen/app_text_size_xs"
                    android:textColor="@color/app_text_caption" />

                <TextView
                    android:id="@+id/tvRunCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Runs: 0"
                    android:textSize="@dimen/app_text_size_xs"
                    android:textColor="@color/app_text_caption" />
            </LinearLayout>

            <!-- Row 4: Action buttons -->
            <LinearLayout
                android:id="@+id/rowActionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/app_spacing_md"
                android:gravity="end">

                <ImageButton
                    android:id="@+id/btnRevert"
                    android:layout_width="@dimen/app_btn_icon"
                    android:layout_height="@dimen/app_btn_icon"
                    android:src="@drawable/ic_undo_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/app_violet_nd"
                    android:contentDescription="Revert to Queue"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnResetSlice"
                    android:layout_width="@dimen/app_btn_icon"
                    android:layout_height="@dimen/app_btn_icon"
                    android:src="@drawable/outline_rotate_left_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/app_orange_nd"
                    android:contentDescription="Reset Timer Slice"
                    android:visibility="gone" />

                <!-- Group expand/collapse (visible for group items only) -->
                <ImageButton
                    android:id="@+id/btnGroupToggle"
                    android:layout_width="@dimen/app_btn_icon"
                    android:layout_height="@dimen/app_btn_icon"
                    android:src="@drawable/outline_arrow_circle_down_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/colorPrimary"
                    android:contentDescription="Toggle Group"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnRun"
                    android:layout_width="@dimen/app_btn_icon"
                    android:layout_height="@dimen/app_btn_icon"
                    android:src="@drawable/outline_timer_play_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/colorPrimary"
                    android:contentDescription="Run Task" />

                <ImageButton
                    android:id="@+id/btnComplete"
                    android:layout_width="@dimen/app_btn_icon"
                    android:layout_height="@dimen/app_btn_icon"
                    android:src="@drawable/outline_check_circle_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/app_green_nd"
                    android:contentDescription="Mark Complete" />

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="@dimen/app_btn_icon"
                    android:layout_height="@dimen/app_btn_icon"
                    android:src="@drawable/baseline_delete_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="@color/app_color_error"
                    android:contentDescription="Delete" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
