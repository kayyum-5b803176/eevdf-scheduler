<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/App.PageScroll"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/App.PageContent">

        <!-- ── Time Window Selector ───────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/app_card_padding_sm">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ANALYSIS WINDOW"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Range (e.g. 7d, 24h, 30m)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_marginEnd="@dimen/app_spacing_md">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWindowRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:digits="0123456789dDhHmMsS "
                            android:maxLength="20"
                            android:text="7d" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyWindow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apply"
                        android:textSize="@dimen/app_text_size_md"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvWindowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Showing last 7 days"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_label"
                    android:layout_marginTop="@dimen/app_spacing_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Overview Tiles ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/app_spacing_lg"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap">
            <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TOTAL RUNTIME" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvTotalRuntime" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="@dimen/app_text_size_xl"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/app_text_label" android:layout_marginTop="@dimen/app_spacing_cs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TOTAL RUNS" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvTotalRuns" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="@dimen/app_text_size_xl"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/app_success_text" android:layout_marginTop="@dimen/app_spacing_cs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/app_spacing_lg"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap">
            <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ACTIVE TASKS" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvActiveTasks" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="@dimen/app_text_size_xl"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/app_warning_text" android:layout_marginTop="@dimen/app_spacing_cs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AVG RUN/TASK" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvAvgRun" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="@dimen/app_text_size_xl"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/app_stat_accent" android:layout_marginTop="@dimen/app_spacing_cs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ── Time Distribution ─────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TIME DISTRIBUTION" android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12" android:layout_marginBottom="@dimen/app_spacing_lg" />
                <LinearLayout android:id="@+id/llDistribution" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Most / Least Frequent ─────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MOST FREQUENT" android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12" android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout android:id="@+id/llMostFrequent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LEAST FREQUENT" android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12" android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout android:id="@+id/llLeastFrequent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Longest Untouched ─────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LONGEST UNTOUCHED" android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12" android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout android:id="@+id/llUntouched" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Quota Violators ───────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="QUOTA VIOLATIONS" android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12" android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout android:id="@+id/llQuotaViolators" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Task Switching ────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TASK SWITCHING OVERHEAD" android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12" android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout android:id="@+id/llSwitching" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Window Activity ───────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="RUNTIME IN WINDOW" android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12" android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout android:id="@+id/llWindowActivity" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Peak Day ──────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PEAK USAGE DAY (ALL TIME)" android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12" android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout android:id="@+id/llPeakDay" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Weekday Heatmap ───────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DAY-OF-WEEK PATTERN" android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12" android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout android:id="@+id/llWeekday" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Streaks ───────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="@dimen/app_card_padding_sm">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CURRENT STREAKS" android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12" android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout android:id="@+id/llStreak" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View android:layout_width="match_parent" android:layout_height="@dimen/app_spacing_xl" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
