<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/uiCustomizationToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/app_card_padding_xl"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ══ APPEARANCE ═════════════════════════════════════════════ -->


            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_lg">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dark Mode"
                        android:textSize="@dimen/app_text_size_lg"
                        android:textColor="@color/app_text_title"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose between light theme, dark theme, or follow the system setting."
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_sm"
                        android:layout_marginBottom="@dimen/app_spacing_xl" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/darkModeToggleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDarkModeLight"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDarkModeDark"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dark" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDarkModeSystem"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="System" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ SIMPLE MODE ═════════════════════════════════════════════ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_lg">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSimpleMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Simple Mode"
                        android:textSize="@dimen/app_text_size_lg"
                        android:textColor="@color/app_text_title"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Unselected cards show name only. Tap to expand. Running task stays expanded."
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_sm" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ UNIT FORMAT ══════════════════════════════════════════════ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_lg">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchUnitFormat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SI Unit Format"
                        android:textSize="@dimen/app_text_size_lg"
                        android:textColor="@color/app_text_title"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="VRT, VDL, Runs, TRT use SI suffixes. Floats: 88191 → 88.19K. Integers: 1800 → 1.8K. Time: 3d 28h 3s → 3d 28h."
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_sm" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ OVERLAY INTENT ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_lg">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchOverlayIntent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Overlay Intent"
                        android:textSize="@dimen/app_text_size_lg"
                        android:textColor="@color/app_text_title"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Don't show the full-screen timer-expiry overlay while one of the selected apps is open. The alarm still rings and shows a notification. Hardware keys (Stop / Restart) work only while the overlay is shown, so they are inactive on these apps."
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_sm"
                        android:lineSpacingMultiplier="1.3" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/app_divider"
                        android:background="@color/infoBoxBackground"
                        android:layout_marginTop="@dimen/app_spacing_xl" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchOverlayIntentLockOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Show intent only on lock screen"
                        android:textSize="@dimen/app_text_size_lg"
                        android:textColor="@color/app_text_title"
                        android:layout_marginTop="@dimen/app_spacing_lg" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="When on, the overlay appears only while the device is locked (like the Clock app). On an unlocked device the alarm just rings with a notification. This overrides the app list below."
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_sm"
                        android:lineSpacingMultiplier="1.3" />

                    <LinearLayout
                        android:id="@+id/rowOverlayIntentApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="@dimen/app_card_padding_md"
                        android:paddingBottom="@dimen/app_spacing_sm">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Configure apps"
                                android:textSize="@dimen/app_text_size_lg"
                                android:textColor="@color/app_text_title" />

                            <TextView
                                android:id="@+id/tvOverlayIntentApps"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="No apps selected"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:layout_marginTop="@dimen/app_spacing_cs" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/app_spacing_lg"
                            android:text="\u203A"
                            android:textSize="@dimen/app_text_size_cl"
                            android:textColor="@color/divider" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ CARD HEIGHT ══════════════════════════════════════════════ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Card Height"
                            android:textSize="@dimen/app_text_size_lg"
                            android:textColor="@color/app_text_title"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvCardHeightValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 (Default)"
                            android:textSize="@dimen/app_text_size_md"
                            android:textColor="@color/app_text_label"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Adjusts card padding. Font size unchanged."
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_cs"
                        android:layout_marginBottom="@dimen/app_spacing_md" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderCardHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1"
                        android:valueTo="5"
                        android:stepSize="1"
                        android:value="5"
                        app:thumbColor="@color/colorPrimary"
                        app:trackColorActive="@color/colorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Compact"
                            android:textSize="@dimen/app_text_size_xs"
                            android:textColor="@color/app_text_body" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Default"
                            android:textSize="@dimen/app_text_size_xs"
                            android:textColor="@color/app_text_body" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ WINDOW CALIBRATE ═════════════════════════════════════════ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_lg">

                    <!-- Toggle -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoAdjust"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Window Calibrate"
                        android:textSize="@dimen/app_text_size_lg"
                        android:textColor="@color/app_text_title"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hides stat rows on FLOAT / MINI profiles. NORMAL keeps full layout."
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_sm" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/app_divider"
                        android:layout_marginTop="@dimen/app_spacing_lg"
                        android:layout_marginBottom="@dimen/app_spacing_lg"
                        android:background="@color/divider" />

                    <!-- Live window stats -->
                    <TextView
                        android:id="@+id/tvWindowLiveStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="reading…"
                        android:textSize="@dimen/app_text_size_xs"
                        android:textColor="@color/quotaTextExceeded"
                        android:fontFamily="monospace"
                        android:background="@color/infoBoxBackground"
                        android:paddingStart="@dimen/app_spacing_md"
                        android:paddingEnd="@dimen/app_spacing_md"
                        android:paddingTop="@dimen/app_spacing_sm"
                        android:paddingBottom="@dimen/app_spacing_sm" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/app_divider"
                        android:layout_marginTop="@dimen/app_spacing_lg"
                        android:layout_marginBottom="@dimen/app_spacing_lg"
                        android:background="@color/divider" />

                    <!-- Calibrate Profiles header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CALIBRATE PROFILES"
                        android:textSize="@dimen/app_text_size_xs"
                        android:letterSpacing="0.12"
                        android:textColor="@color/app_text_label"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="@dimen/app_spacing_md" />

                    <!-- 3-column profile picker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- FLOAT profile card -->
                        <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                            android:id="@+id/cardCalFloat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="@dimen/app_card_gap"
                            android:layout_marginEnd="@dimen/app_card_gap"
                            android:layout_marginTop="@dimen/app_card_gap"
                            android:layout_marginBottom="@dimen/app_card_gap">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="@dimen/app_card_padding_sm">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="FLOAT"
                                    android:textSize="@dimen/app_text_size_sm"
                                    android:textColor="@color/app_text_label"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView
                                    android:id="@+id/tvCalFloatDims"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="not set"
                                    android:textSize="@dimen/app_text_size_xs"
                                    android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- NORMAL profile card -->
                        <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                            android:id="@+id/cardCalNormal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="@dimen/app_card_gap"
                            android:layout_marginEnd="@dimen/app_card_gap"
                            android:layout_marginTop="@dimen/app_card_gap"
                            android:layout_marginBottom="@dimen/app_card_gap">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="@dimen/app_card_padding_sm">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NORMAL"
                                    android:textSize="@dimen/app_text_size_sm"
                                    android:textColor="@color/app_text_label"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView
                                    android:id="@+id/tvCalNormalDims"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="not set"
                                    android:textSize="@dimen/app_text_size_xs"
                                    android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- MINI profile card -->
                        <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                            android:id="@+id/cardCalMini"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="@dimen/app_card_gap"
                            android:layout_marginEnd="@dimen/app_card_gap"
                            android:layout_marginTop="@dimen/app_card_gap"
                            android:layout_marginBottom="@dimen/app_card_gap">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="@dimen/app_card_padding_sm">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MINI"
                                    android:textSize="@dimen/app_text_size_sm"
                                    android:textColor="@color/app_text_label"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView
                                    android:id="@+id/tvCalMiniDims"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="not set"
                                    android:textSize="@dimen/app_text_size_xs"
                                    android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Hint -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap to record · Long-press to clear"
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_md" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
