<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/app_red_dk"
    android:padding="32dp">

    <!-- Alarm icon removed -->

    <!-- "Timer expired" label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TIMER EXPIRED"
        android:textColor="@color/app_red_lt"
        android:textSize="@dimen/app_text_size_md"
        android:letterSpacing="0.15"
        android:textAllCaps="true"
        android:layout_marginBottom="@dimen/app_spacing_lg" />

    <!-- Task name -->
    <TextView
        android:id="@+id/tvAlarmActivityTaskName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Task Name"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="@dimen/app_spacing_xl" />

    <!-- Elapsed counter counting up -->
    <TextView
        android:id="@+id/tvAlarmActivityElapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00"
        android:textColor="@android:color/white"
        android:textSize="64sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="@dimen/app_spacing_md" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="elapsed since expiry"
        android:textColor="@color/app_red_lt"
        android:textSize="@dimen/app_text_size_md"
        android:layout_marginBottom="48dp" />

    <!-- Stop button — large, easy to tap when groggy -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAlarmActivityStop"
        android:layout_width="240dp"
        android:layout_height="@dimen/app_size_alarm"
        android:text="Stop"
        android:textColor="@color/app_red_dk"
        android:textSize="@dimen/app_text_size_xl"
        android:fontFamily="sans-serif-medium"
        app:backgroundTint="@android:color/white"
        app:cornerRadius="32dp" />

</LinearLayout>
