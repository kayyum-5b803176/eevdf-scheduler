<?xml version="1.0" encoding="utf-8"?>
<!--
  Task Type card — group/interrupt toggles only.

  groupTypeSection    — hidden by default; AddTaskGroupSection.kt shows it when
                        groups mode is enabled in settings.
  interruptSection    — single "Assign as interrupt" toggle; when ON reveals a
                        slot picker dropdown (INT-A / INT-B) and a single
                        conflict-owner text.  Managed by AddTaskInterruptSection.kt.

  Task profile, resume type, and notice fields live in section_add_task_taskconfig.xml.
-->
<com.google.android.material.card.MaterialCardView
    style="@style/App.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/app_card_margin_horizontal"
    android:layout_marginEnd="@dimen/app_card_margin_horizontal"
    android:layout_marginTop="@dimen/app_card_margin_top"
    android:layout_marginBottom="@dimen/app_card_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/app_card_padding_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task Type"
            android:textSize="@dimen/app_text_size_md"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/app_text_label"
            android:layout_marginBottom="@dimen/app_spacing_lg" />

        <!-- Group option — hidden when groups disabled (controlled by AddTaskGroupSection.kt) -->
        <LinearLayout
            android:id="@+id/groupTypeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchIsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Assign as group (container)" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_divider"
                android:background="@color/app_divider_inner"
                android:layout_marginTop="@dimen/app_spacing_xl"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

        </LinearLayout>

        <!-- Interrupt — single toggle reveals INT-A / INT-B slot picker -->
        <LinearLayout
            android:id="@+id/interruptSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchIsInterrupt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Assign as interrupt" />

            <!-- Slot picker — hidden until toggle is ON -->
            <LinearLayout
                android:id="@+id/layoutInterruptSlotPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/app_spacing_lg"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/App.TextInput.Dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Interrupt slot">

                    <AutoCompleteTextView
                        android:id="@+id/actvInterruptSlot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:cursorVisible="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvInterruptOwner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_color_error"
                    android:layout_marginTop="@dimen/app_spacing_md"
                    android:visibility="gone" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_divider"
                android:background="@color/app_divider_inner"
                android:layout_marginTop="@dimen/app_spacing_xl"
                android:layout_marginBottom="0dp" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
