<?xml version="1.0" encoding="utf-8"?>
<!--
  Quota Limit card — max-runtime-per-period toggle and duration fields.

  switchQuotaEnabled — shows/hides layoutQuotaFields
  layoutQuotaFields  — hidden by default
  etQuota            — NdNhNmNs format; parsed by parseQuotaInput()
  tvQuotaPreview     — live formatted display updated by AddTaskQuotaSection
  etPeriod           — rolling window duration; default value "1d"
  tvPeriodPreview    — live formatted display
  tvQuotaError       — inline validation message shown by saveTask()
-->
<com.google.android.material.card.MaterialCardView
    style="@style/App.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/app_card_margin_horizontal"
    android:layout_marginEnd="@dimen/app_card_margin_horizontal"
    android:layout_marginTop="@dimen/app_card_margin_top"
    android:layout_marginBottom="@dimen/app_card_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/app_card_padding_md">

        <!-- Header row: title + subtitle + toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quota Limit"
                    android:textSize="@dimen/app_text_size_md"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/app_text_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Max time allowed per period (like Linux cgroup quota)"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:layout_marginTop="@dimen/app_spacing_cs" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchQuotaEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Fields: shown when toggle is ON -->
        <LinearLayout
            android:id="@+id/layoutQuotaFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/app_spacing_lg"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_divider"
                android:background="@color/app_divider_inner"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <!-- Quota field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/app_spacing_sm">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quota (max run time)"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_title"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvQuotaPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_label"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Format: NdNhNmNs  e.g. 30m · 2h · 1d4h · 7d (1s–365d)"
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_text_hint"
                android:layout_marginBottom="@dimen/app_spacing_md" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Quota  (e.g. 2h, 30m, 1d)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="@dimen/app_spacing_xl">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etQuota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:digits="0123456789dDhHmMsS "
                    android:maxLength="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Period field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/app_spacing_sm">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Period (time window)"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_title"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvPeriodPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1d"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_label"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rolling window for the quota; resets automatically (1s–365d)"
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_text_hint"
                android:layout_marginBottom="@dimen/app_spacing_md" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Period  (e.g. 1d, 7d, 1h)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPeriod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:digits="0123456789dDhHmMsS "
                    android:text="1d"
                    android:maxLength="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvQuotaError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_color_error"
                android:layout_marginTop="@dimen/app_spacing_md"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
