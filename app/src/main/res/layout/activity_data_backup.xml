<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/dataBackupToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/app_card_padding_xl"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Export card -->
            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_lg">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/app_spacing_md">
                        <ImageView
                            android:layout_width="@dimen/app_icon"
                            android:layout_height="@dimen/app_icon"
                            android:src="@android:drawable/ic_menu_save"
                            android:contentDescription="Export icon"
                            android:layout_marginEnd="@dimen/app_spacing_lg"
                            app:tint="@color/colorPrimary" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Export Database"
                                android:textSize="@dimen/app_text_size_lg"
                                android:textColor="@color/app_text_title"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Save a complete copy of the database to a .db file"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:layout_marginTop="@dimen/app_spacing_cs" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Export Database"
                        android:layout_marginTop="@dimen/app_spacing_sm"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Import card -->
            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_lg">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/app_spacing_md">
                        <ImageView
                            android:layout_width="@dimen/app_icon"
                            android:layout_height="@dimen/app_icon"
                            android:src="@android:drawable/ic_menu_upload"
                            android:contentDescription="Import icon"
                            android:layout_marginEnd="@dimen/app_spacing_lg"
                            app:tint="@color/app_color_error" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Import Database"
                                android:textSize="@dimen/app_text_size_lg"
                                android:textColor="@color/app_text_title"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Restore from a .db backup file — replaces all current data"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:layout_marginTop="@dimen/app_spacing_cs" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_warning_notice"
                        android:padding="@dimen/app_card_padding_sm"
                        android:layout_marginBottom="@dimen/app_spacing_md"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="This will permanently replace all existing tasks — app will restart"
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/quotaTextExceeded" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Import Database"
                        android:layout_marginTop="@dimen/app_spacing_sm"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="@color/app_color_error"
                        app:rippleColor="@color/app_color_error" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progress + status -->
            <ProgressBar
                android:id="@+id/dataBackupProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/app_spacing_lg" />
            <TextView
                android:id="@+id/tvDataBackupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/app_text_size_md"
                android:gravity="center"
                android:textColor="@color/app_text_body"
                android:paddingBottom="@dimen/app_spacing_md" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
