<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ── Month Navigation (ultra-compact) ─────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_size_calendar_row"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/app_spacing_sm"
        android:paddingEnd="@dimen/app_spacing_sm"
        android:layout_marginStart="@dimen/app_card_gap"
        android:layout_marginEnd="@dimen/app_card_gap">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevMonth"
            android:layout_width="@dimen/app_day_cell"
            android:layout_height="@dimen/app_day_cell"
            android:text="‹"
            android:textSize="@dimen/app_text_size_xl"
            android:padding="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <TextView
            android:id="@+id/tvMonthTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="@dimen/app_text_size_md"
            android:textStyle="bold"
            android:textColor="@color/app_text_title"
            android:text="May 2026" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextMonth"
            android:layout_width="@dimen/app_day_cell"
            android:layout_height="@dimen/app_day_cell"
            android:text="›"
            android:textSize="@dimen/app_text_size_xl"
            android:padding="0dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

    <!-- ── Scrollable body ──────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        style="@style/App.PageScroll"
        android:fillViewport="true">

        <LinearLayout
            style="@style/App.PageContent">

            <!-- ── Calendar Grid ──────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_spacing_cs">

                    <LinearLayout
                        android:id="@+id/llCalHeader"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/llCalGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Hint ───────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvCalHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap: task overview  •  Hold: with run times"
                android:textSize="@dimen/app_text_size_xs"
                android:textColor="@color/app_text_hint"
                android:gravity="center"
                android:layout_marginBottom="@dimen/app_spacing_md" />

            <!-- ── Day Detail Panel ───────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:id="@+id/cardDayDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                android:visibility="gone"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_sm">

                    <!-- Date + mode label row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/app_spacing_md"
                        android:layout_marginStart="@dimen/app_card_gap"
                        android:layout_marginEnd="@dimen/app_card_gap">

                        <TextView
                            android:id="@+id/tvDetailDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="@dimen/app_text_size_md"
                            android:textStyle="bold"
                            android:textColor="@color/app_text_title" />

                        <TextView
                            android:id="@+id/tvDetailMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/app_text_size_xs"
                            android:textColor="@color/app_text_hint"
                            android:text="overview" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llDetailSessions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvDetailEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No sessions on this day"
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_hint"
                        android:gravity="center"
                        android:visibility="gone"
                        android:padding="@dimen/app_spacing_md" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
