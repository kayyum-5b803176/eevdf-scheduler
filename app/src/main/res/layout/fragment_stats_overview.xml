<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/app_page_padding_vertical"
            android:paddingBottom="@dimen/app_page_padding_vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ── Time Window Selector ───────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ANALYSIS WINDOW"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Range (e.g. 7d, 24h, 30m)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_marginEnd="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWindowRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:digits="0123456789dDhHmMsS "
                            android:maxLength="20"
                            android:text="7d" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyWindow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apply"
                        android:textSize="13sp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvWindowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Showing last 7 days"
                    android:textSize="11sp"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Overview Tiles ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                android:layout_marginStart="@dimen/app_card_margin_horizontal"
                android:layout_marginEnd="@dimen/app_card_margin_horizontal"
                android:layout_marginBottom="@dimen/app_card_spacing">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="@dimen/app_page_padding_vertical"
            android:paddingBottom="@dimen/app_page_padding_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TOTAL RUNTIME" android:textSize="9sp" android:textColor="#9E9E9E" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvTotalRuntime" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="18sp"
                        android:textStyle="bold" android:textColor="@color/colorPrimary" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                android:layout_marginStart="@dimen/app_card_margin_horizontal"
                android:layout_marginEnd="@dimen/app_card_margin_horizontal"
                android:layout_marginBottom="@dimen/app_card_spacing">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="@dimen/app_page_padding_vertical"
            android:paddingBottom="@dimen/app_page_padding_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TOTAL RUNS" android:textSize="9sp" android:textColor="#9E9E9E" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvTotalRuns" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="18sp"
                        android:textStyle="bold" android:textColor="#1B5E20" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                android:layout_marginStart="@dimen/app_card_margin_horizontal"
                android:layout_marginEnd="@dimen/app_card_margin_horizontal"
                android:layout_marginBottom="@dimen/app_card_spacing">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="@dimen/app_page_padding_vertical"
            android:paddingBottom="@dimen/app_page_padding_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ACTIVE TASKS" android:textSize="9sp" android:textColor="#9E9E9E" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvActiveTasks" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="18sp"
                        android:textStyle="bold" android:textColor="#E65100" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                android:layout_marginStart="@dimen/app_card_margin_horizontal"
                android:layout_marginEnd="@dimen/app_card_margin_horizontal"
                android:layout_marginBottom="@dimen/app_card_spacing">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="@dimen/app_page_padding_vertical"
            android:paddingBottom="@dimen/app_page_padding_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="AVG RUN/TASK" android:textSize="9sp" android:textColor="#9E9E9E" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvAvgRun" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--" android:textSize="18sp"
                        android:textStyle="bold" android:textColor="#4A148C" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ── Time Distribution ─────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TIME DISTRIBUTION" android:textSize="11sp" android:textColor="#9E9E9E"
                    android:letterSpacing="0.12" android:layout_marginBottom="10dp" />
                <LinearLayout android:id="@+id/llDistribution" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Most / Least Frequent ─────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MOST FREQUENT" android:textSize="11sp" android:textColor="#9E9E9E"
                    android:letterSpacing="0.12" android:layout_marginBottom="6dp" />
                <LinearLayout android:id="@+id/llMostFrequent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LEAST FREQUENT" android:textSize="11sp" android:textColor="#9E9E9E"
                    android:letterSpacing="0.12" android:layout_marginBottom="6dp" />
                <LinearLayout android:id="@+id/llLeastFrequent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Longest Untouched ─────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LONGEST UNTOUCHED" android:textSize="11sp" android:textColor="#9E9E9E"
                    android:letterSpacing="0.12" android:layout_marginBottom="6dp" />
                <LinearLayout android:id="@+id/llUntouched" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Quota Violators ───────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="QUOTA VIOLATIONS" android:textSize="11sp" android:textColor="#9E9E9E"
                    android:letterSpacing="0.12" android:layout_marginBottom="6dp" />
                <LinearLayout android:id="@+id/llQuotaViolators" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Task Switching ────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TASK SWITCHING OVERHEAD" android:textSize="11sp" android:textColor="#9E9E9E"
                    android:letterSpacing="0.12" android:layout_marginBottom="6dp" />
                <LinearLayout android:id="@+id/llSwitching" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Window Activity ───────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="RUNTIME IN WINDOW" android:textSize="11sp" android:textColor="#9E9E9E"
                    android:letterSpacing="0.12" android:layout_marginBottom="6dp" />
                <LinearLayout android:id="@+id/llWindowActivity" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Peak Day ──────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PEAK USAGE DAY (ALL TIME)" android:textSize="11sp" android:textColor="#9E9E9E"
                    android:letterSpacing="0.12" android:layout_marginBottom="6dp" />
                <LinearLayout android:id="@+id/llPeakDay" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Weekday Heatmap ───────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DAY-OF-WEEK PATTERN" android:textSize="11sp" android:textColor="#9E9E9E"
                    android:letterSpacing="0.12" android:layout_marginBottom="6dp" />
                <LinearLayout android:id="@+id/llWeekday" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Streaks ───────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="3dp"
            android:layout_marginStart="@dimen/app_card_margin_horizontal"
            android:layout_marginEnd="@dimen/app_card_margin_horizontal"
            android:layout_marginBottom="@dimen/app_card_spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CURRENT STREAKS" android:textSize="11sp" android:textColor="#9E9E9E"
                    android:letterSpacing="0.12" android:layout_marginBottom="6dp" />
                <LinearLayout android:id="@+id/llStreak" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View android:layout_width="match_parent" android:layout_height="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
