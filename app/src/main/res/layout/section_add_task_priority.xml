<?xml version="1.0" encoding="utf-8"?>
<!--
  Schedule Priority card — 1–7 integer slider with live band description.

  tvPriorityLabel  — updated by AddTaskCategoryPrioritySection.updatePriorityDisplay()
  tvPriorityInfo   — updated by AddTaskCategoryPrioritySection.updatePriorityDisplay();
                     shows override text when pinned share is active.
-->
<com.google.android.material.card.MaterialCardView
    style="@style/App.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/app_card_margin_horizontal"
    android:layout_marginEnd="@dimen/app_card_margin_horizontal"
    android:layout_marginTop="@dimen/app_card_margin_top"
    android:layout_marginBottom="@dimen/app_card_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/app_card_padding_md">

        <!-- Header row: section title + live value label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Schedule Priority"
                android:textSize="@dimen/app_text_size_md"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/app_text_label" />

            <TextView
                android:id="@+id/tvPriorityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Priority: 4"
                android:textSize="@dimen/app_text_size_md"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/app_text_title" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_spacing_md"
            android:valueFrom="1"
            android:valueTo="7"
            android:stepSize="1"
            android:value="4"
            app:haloColor="@color/colorPrimary"
            app:thumbColor="@color/colorPrimary"
            app:trackColorActive="@color/colorPrimary" />

        <!-- Scale end-labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1 (Low)"
                android:textSize="@dimen/app_text_size_xs"
                android:textColor="@color/app_text_hint" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 (Critical)"
                android:textSize="@dimen/app_text_size_xs"
                android:textColor="@color/app_text_hint" />
        </LinearLayout>

        <!-- Band description / pinned-share override notice -->
        <TextView
            android:id="@+id/tvPriorityInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_spacing_lg"
            android:text=""
            android:textSize="@dimen/app_text_size_sm"
            android:textColor="@color/app_text_tertiary"
            android:background="@color/app_surface_subtle"
            android:padding="@dimen/app_card_padding_sm" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
