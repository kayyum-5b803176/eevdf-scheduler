<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/App.PageScroll"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/App.PageContent">

        <!-- ── Analysis Window ───────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/app_card_padding_sm">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANALYSIS WINDOW"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="@dimen/app_spacing_md" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Range (e.g. 7d, 24h, 30m)"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_marginEnd="@dimen/app_spacing_md">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etChartsWindowRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:digits="0123456789dDhHmMsS "
                            android:maxLength="20"
                            android:text="7d" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChartsApplyWindow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apply"
                        android:textSize="@dimen/app_text_size_md"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvChartsPeriodLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Showing last 7 days"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_label"
                    android:layout_marginTop="@dimen/app_spacing_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



        <!-- ── Line Chart: Human Load Average (3-EWMA) ─────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/app_card_padding_sm">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOAD AVERAGE"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total load tracked per day"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_title"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChartLoadAvg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_chart_height_lg" />
                <TextView
                    android:id="@+id/tvLoadAvgEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No tasks with load factor enabled in this period"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_hint"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="@dimen/app_card_padding_lg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Radar Chart: Load Factor Profile (Cognitive · Physical · Emotional) ── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/app_card_padding_sm">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOAD FACTOR PROFILE"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Relative bias across load dimensions"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_title"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />
                <com.github.mikephil.charting.charts.RadarChart
                    android:id="@+id/radarChartLoadFactor"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_chart_height_md" />
                <TextView
                    android:id="@+id/tvRadarLoadFactorEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No load factor data in this period"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_hint"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="@dimen/app_card_padding_lg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Bar Chart: Daily Activity ────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/app_card_padding_sm">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAILY ACTIVITY"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total hours tracked per day"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_title"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartDaily"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_chart_height_md" />
                <TextView
                    android:id="@+id/tvBarDailyEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No daily data in this period"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_hint"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="@dimen/app_card_padding_lg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Line Chart: Task Trends ──────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/app_card_padding_sm">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TASK TRENDS"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily runtime trend for top tasks (hours)"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_title"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChartTrend"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_chart_height_md" />
                <TextView
                    android:id="@+id/tvLineEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Not enough data for trend analysis"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_hint"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="@dimen/app_card_padding_lg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Horizontal Bar: Run Count per Task ───────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/app_card_padding_sm">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RUN FREQUENCY"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sessions per day by category"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_title"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartRunCount"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_chart_height_md" />
                <TextView
                    android:id="@+id/tvBarCountEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No run data in this period"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_hint"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="@dimen/app_card_padding_lg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Radar Chart: Weekday Pattern ─────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/app_card_padding_sm">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEEKDAY PATTERN"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total runtime by day of week"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_title"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />
                <com.github.mikephil.charting.charts.RadarChart
                    android:id="@+id/radarChartWeekday"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_chart_height_lg" />
                <TextView
                    android:id="@+id/tvRadarEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Not enough weekday data yet"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_hint"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="@dimen/app_card_padding_lg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Scatter Chart: Session Duration Distribution ──────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_card_gap"
            android:layout_marginEnd="@dimen/app_card_gap"
            android:layout_marginTop="@dimen/app_card_gap"
            android:layout_marginBottom="@dimen/app_card_gap">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/app_card_padding_sm">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION DURATION DISTRIBUTION"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Each dot is one session (x=day offset, y=duration min)"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_title"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />
                <com.github.mikephil.charting.charts.ScatterChart
                    android:id="@+id/scatterChart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_chart_height_md" />
                <TextView
                    android:id="@+id/tvScatterEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No session data in this period"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_hint"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="@dimen/app_card_padding_lg" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View android:layout_width="match_parent" android:layout_height="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
