<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout demo screen. Reached from Display -> render -> "Layout" card.

    Ships with the same blank/unwired TabLayout pattern every screen in this
    catalog carries, per convention.

    demoContainer below is intentionally empty. Every demo card is built at
    runtime by LayoutDemoActivity.kt through the closed template
    construction API (com.eevdf.app.core.template.*CardView) - there is no
    hand-authored demo card XML in this file to copy or drift from. The
    same NavCardView/ToggleCardView/ValueCardView/DropdownCardView classes
    that build these demos are the only sanctioned way any real settings
    screen builds a row, so what renders here is not an approximation of
    production output - it is production output.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/layoutDemoToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <!-- Blank, unwired - same pattern every screen in this catalog carries. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />

    <ScrollView style="@style/App.PageScroll">

        <LinearLayout
            android:id="@+id/demoContainer"
            style="@style/App.PageContent" />

    </ScrollView>
</LinearLayout>
