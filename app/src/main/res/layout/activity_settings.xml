<?xml version="1.0" encoding="utf-8"?>
<!--
    Text casing: all labels and descriptions are lowercase.
    Abbreviations and acronyms stay uppercase (UI, API, ID, EEVDF, SI, DL, RT).
    See docs/UI_TEXT_CONVENTIONS.md for the full rule and checklist.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/settingsTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />

    <ScrollView
        style="@style/App.PageScroll"
        android:id="@+id/settingsScrollView">

        <LinearLayout
            style="@style/App.PageContent">

            <!-- ══ TAB: platform ════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/tabContentPlatform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">


                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Nav"
                        android:id="@+id/rowVisual">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="display" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="appearance, layout, density, overlay" />
                        </LinearLayout>
                        <TextView style="@style/App.Text.Chevron"
                            android:text="&#8250;" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />

                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Nav"
                        android:id="@+id/rowSoundVibration">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="sound and vibration" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="profiles, patterns, haptic feedback" />
                        </LinearLayout>
                        <TextView style="@style/App.Text.Chevron"
                            android:text="&#8250;" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ══ TAB: app ═════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/tabContentApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">


                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Nav"
                        android:id="@+id/rowButtonAction">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="control" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="hardware keys, quick action" />
                        </LinearLayout>
                        <TextView style="@style/App.Text.Chevron"
                            android:text="&#8250;" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />

                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Reserved">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="event handle service" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="no settings available yet" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />

                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Nav"
                        android:id="@+id/rowAutoSwitch">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="auto switch" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="pause and resume on incoming calls" />
                        </LinearLayout>
                        <TextView style="@style/App.Text.Chevron"
                            android:text="&#8250;" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ══ TAB: core ════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/tabContentCore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">


                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Reserved">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="system config" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="no settings available yet" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />

                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Reserved">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="core algorithm" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="no settings available yet" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />

                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Reserved">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="rules" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="no settings available yet" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ══ TAB: data ════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/tabContentData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">


                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Nav"
                        android:id="@+id/rowDataBackup">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="data and backup" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="export and import app data" />
                        </LinearLayout>
                        <TextView style="@style/App.Text.Chevron"
                            android:text="&#8250;" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Nav"
                        android:id="@+id/rowMultiUserSync">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="multiuser sync" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="share task state across devices" />
                        </LinearLayout>
                        <TextView style="@style/App.Text.Chevron"
                            android:text="&#8250;" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />

                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Reserved">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="logs" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="no settings available yet" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />

                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                                        <LinearLayout
                        style="@style/App.Row.Reserved">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="about" />
                            <TextView style="@style/App.Row.Subtitle"
                                android:text="no settings available yet" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
