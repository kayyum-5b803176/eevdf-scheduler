<?xml version="1.0" encoding="utf-8"?>
<!--
    Color matrix screen. Reached from Display -> render -> "color" card.

    13 color-name rows (y-axis) x 7 lumen-code columns (x-axis: 50, 100,
    300, 500, 700, 800, 900). Every swatch's android:background references
    the real @color/app_<family>_<stop> resource - never a hardcoded hex
    copy - so this grid always reflects colors.xml, never a frozen
    snapshot of it. Tapping a swatch updates the detail strip with that
    swatch's family name, lumen code, real hex, and token name.

    Ships with the same blank/unwired TabLayout pattern every screen in
    this catalog carries, per convention, regardless of whether a use is
    foreseen for this particular screen.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/colorMatrixToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <!-- Blank, unwired - same pattern every screen in this catalog carries. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />

    <TextView
        android:id="@+id/tvColorDetail"
        style="@style/App.ColorMatrix.DetailStrip"
        android:text="Tap a swatch to see its name, lumen code, and hex" />

    <ScrollView style="@style/App.PageScroll">

        <LinearLayout style="@style/App.PageContent">

            <!-- ══ Column header row: lumen codes ══════════════════════ -->
