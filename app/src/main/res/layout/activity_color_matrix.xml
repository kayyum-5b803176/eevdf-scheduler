                <View android:id="@+id/swatch_grey_lt" style="@style/App.ColorMatrix.Swatch" android:background="@color/app_grey_lt" android:tag="grey|300|app_grey_lt" />
                <View android:id="@+id/swatch_grey_nd" style="@style/App.ColorMatrix.Swatch" android:background="@color/app_grey_nd" android:tag="grey|500|app_grey_nd" />
                <View android:id="@+id/swatch_grey_dk" style="@style/App.ColorMatrix.Swatch" android:background="@color/app_grey_dk" android:tag="grey|700|app_grey_dk" />
                <View android:id="@+id/swatch_grey_xd" style="@style/App.ColorMatrix.Swatch" android:background="@color/app_grey_xd" android:tag="grey|800|app_grey_xd" />
