                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_spacing_sm">

                <!-- Empty corner cell, same width as the row-header column -->
                <View
                    android:layout_width="@dimen/app_color_matrix_row_header_width"
                    android:layout_height="@dimen/app_color_matrix_header_row_height" />

                <TextView style="@style/App.ColorMatrix.ColumnHeader" android:text="50" />
                <TextView style="@style/App.ColorMatrix.ColumnHeader" android:text="100" />
                <TextView style="@style/App.ColorMatrix.ColumnHeader" android:text="300" />
                <TextView style="@style/App.ColorMatrix.ColumnHeader" android:text="500" />
                <TextView style="@style/App.ColorMatrix.ColumnHeader" android:text="700" />
                <TextView style="@style/App.ColorMatrix.ColumnHeader" android:text="800" />
                <TextView style="@style/App.ColorMatrix.ColumnHeader" android:text="900" />
            </LinearLayout>

            <!-- ══ 13 rows: color name (row header) + 7 swatches ═══════ -->

