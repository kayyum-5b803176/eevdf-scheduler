<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/autoSwitchToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/app_card_padding_xl"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ── TRIGGERS ──────────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <!-- Call Detection card -->
            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Call Detection"
                                android:textSize="@dimen/app_text_size_lg"
                                android:textColor="@color/app_text_title"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pause and resume tasks automatically during phone calls"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:layout_marginTop="@dimen/app_spacing_cs" />

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchCallDetection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPermissionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone permission not granted"
                        android:textSize="@dimen/app_text_size_sm"
                        android:layout_marginTop="@dimen/app_spacing_md" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/app_divider"
                        android:background="@color/divider"
                        android:layout_marginTop="@dimen/app_spacing_xl"
                        android:layout_marginBottom="@dimen/app_spacing_xl" />

                    <LinearLayout
                        android:id="@+id/layoutCallTaskPicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Switch to task during call"
                            android:textSize="@dimen/app_text_size_md"
                            android:textColor="@color/app_text_title"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="@dimen/app_spacing_md" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCallSlot"
                            style="@style/App.TextInput.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Interrupt slot">

                            <AutoCompleteTextView
                                android:id="@+id/actvCallSlot"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:cursorVisible="false" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/infoBoxBackground"
                        android:padding="@dimen/app_card_padding_sm">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="When a call starts"
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/app_text_body"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→ Current task pauses, switches to assigned call task"
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/app_text_body"
                            android:layout_marginTop="@dimen/app_spacing_cs" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="When the call ends"
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/app_text_body"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="@dimen/app_spacing_md" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→ Returns to previous task and resumes"
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/app_text_body"
                            android:layout_marginTop="@dimen/app_spacing_cs" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── QUICK SWITCH ──────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/app_card_padding_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quick Switch"
                                android:textSize="@dimen/app_text_size_lg"
                                android:textColor="@color/app_text_title"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Switch tasks in the background without opening the app"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:layout_marginTop="@dimen/app_spacing_cs" />

                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchQuickSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/infoBoxBackground"
                        android:padding="@dimen/app_card_padding_sm"
                        android:layout_marginTop="@dimen/app_spacing_xl">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="When OFF"
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/app_text_body"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→ Task switch fires only while the app is open"
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/app_text_body"
                            android:layout_marginTop="@dimen/app_spacing_cs" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="When ON"
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/app_text_body"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="@dimen/app_spacing_md" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→ Switch happens in background; hover bubble available"
                            android:textSize="@dimen/app_text_size_sm"
                            android:textColor="@color/app_text_body"
                            android:layout_marginTop="@dimen/app_spacing_cs" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── HOVER BUBBLE (shown only when Quick Switch is ON) ──────── -->
            <LinearLayout
                android:id="@+id/layoutQuickSwitchOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="@dimen/app_spacing_lg" />

                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/app_card_padding_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Hover Bubble"
                                    android:textSize="@dimen/app_text_size_lg"
                                    android:textColor="@color/app_text_title"
                                    android:fontFamily="sans-serif-medium" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Show a floating bubble during calls on configured apps"
                                    android:textSize="@dimen/app_text_size_sm"
                                    android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs" />

                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchBubble"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvOverlayPermStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Overlay permission not granted"
                            android:textSize="@dimen/app_text_size_sm"
                            android:layout_marginTop="@dimen/app_spacing_md" />

                        <TextView
                            android:id="@+id/tvUsageStatsPermStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Usage access not granted"
                            android:textSize="@dimen/app_text_size_sm"
                            android:layout_marginTop="@dimen/app_spacing_sm" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/app_divider"
                            android:background="@color/divider"
                            android:layout_marginTop="@dimen/app_spacing_xl"
                            android:layout_marginBottom="@dimen/app_spacing_xl" />

                        <LinearLayout
                            android:id="@+id/layoutBubbleOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bubble position"
                                android:textSize="@dimen/app_text_size_md"
                                android:textColor="@color/app_text_title"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="@dimen/app_spacing_md" />

                            <RadioGroup
                                android:id="@+id/rgBubblePosition"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="@dimen/app_spacing_xl">

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/rbFixed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fixed"
                                    android:textSize="@dimen/app_text_size_md"
                                    android:layout_marginEnd="24dp" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/rbDraggable"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Draggable"
                                    android:textSize="@dimen/app_text_size_md" />

                            </RadioGroup>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active on these apps"
                                android:textSize="@dimen/app_text_size_md"
                                android:textColor="@color/app_text_title"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="@dimen/app_spacing_sm" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bubble appears only when one of these apps is in the foreground during a call. Leave empty to show on all apps."
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:layout_marginBottom="@dimen/app_spacing_lg" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnConfigureApps"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Configure Apps"
                                android:layout_marginBottom="@dimen/app_spacing_md" />

                            <TextView
                                android:id="@+id/tvConfiguredApps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All apps (no filter)"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/infoBoxBackground"
                            android:padding="@dimen/app_card_padding_sm">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bubble colour"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● Green — call task timer is running"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:layout_marginTop="@dimen/app_spacing_cs" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● Amber — call task timer is paused"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:layout_marginTop="@dimen/app_spacing_cs" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap bubble"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="@dimen/app_spacing_md" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="→ Toggles pause / resume on the assigned call task"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body"
                                android:layout_marginTop="@dimen/app_spacing_cs" />

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout><!-- end layoutQuickSwitchOptions -->

        </LinearLayout>
    </ScrollView>
</LinearLayout>
