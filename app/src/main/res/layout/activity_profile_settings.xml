<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/profileSettingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/profileTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/app_card_padding_xl"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ══ SOUND ══════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SOUND"
                android:textSize="@dimen/app_text_size_sm" android:letterSpacing="0.12"
                android:textColor="@color/app_text_label"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="12dp" />

            <!-- Timer sound -->
            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/app_spacing_lg" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/app_card_padding_lg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Timer Sound" android:textSize="@dimen/app_text_size_lg"
                                android:textColor="@color/app_text_title" android:fontFamily="sans-serif-medium" />
                            <TextView android:id="@+id/tvProfileSoundName"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="System alarm tone" android:textSize="@dimen/app_text_size_md"
                                android:textColor="@color/app_text_body" android:layout_marginTop="@dimen/app_spacing_cs" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProfilePickSound"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Choose"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sound timeout -->
            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/app_spacing_lg" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/app_card_padding_lg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Sound Timeout"
                            android:textSize="@dimen/app_text_size_lg" android:textColor="@color/app_text_title"
                            android:fontFamily="sans-serif-medium" />
                        <TextView android:id="@+id/tvProfileSoundTimeoutLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="1 min" android:textSize="@dimen/app_text_size_md"
                            android:textColor="@color/app_text_label" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="How long sound plays after timer expires (0 = no timeout)"
                        android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_cs" android:layout_marginBottom="@dimen/app_spacing_md" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderProfileSoundTimeout"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:valueFrom="0" android:valueTo="900" android:stepSize="15" android:value="60"
                        app:thumbColor="@color/colorPrimary" app:trackColorActive="@color/colorPrimary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="No timeout" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 min" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Default volume -->
            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/app_spacing_lg" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/app_card_padding_lg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Default Volume"
                            android:textSize="@dimen/app_text_size_lg" android:textColor="@color/app_text_title"
                            android:fontFamily="sans-serif-medium" />
                        <TextView android:id="@+id/tvProfileVolumeLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="80%" android:textSize="@dimen/app_text_size_md"
                            android:textColor="@color/app_text_label" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderProfileVolume"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:valueFrom="0" android:valueTo="100" android:stepSize="5" android:value="80"
                        app:thumbColor="@color/colorPrimary" app:trackColorActive="@color/colorPrimary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0%" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Gradual volume increase -->
            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/app_card_padding_lg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Gradual Volume Increase"
                            android:textSize="@dimen/app_text_size_lg" android:textColor="@color/app_text_title"
                            android:fontFamily="sans-serif-medium" />
                        <TextView android:id="@+id/tvProfileFadeInLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Off" android:textSize="@dimen/app_text_size_md"
                            android:textColor="@color/app_text_label" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderProfileFadeIn"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:valueFrom="0" android:valueTo="300" android:stepSize="15" android:value="0"
                        app:thumbColor="@color/colorPrimary" app:trackColorActive="@color/colorPrimary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Off" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 min" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ VIBRATION ══════════════════════════════════════════════ -->
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="VIBRATION"
                android:textSize="@dimen/app_text_size_sm" android:letterSpacing="0.12"
                android:textColor="@color/app_text_label" android:fontFamily="sans-serif-medium"
                android:paddingBottom="12dp" />

            <!-- Vibration pattern spinner -->
            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/app_spacing_lg" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/app_card_padding_lg">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Vibration Pattern" android:textSize="@dimen/app_text_size_lg"
                        android:textColor="@color/app_text_title" android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="@dimen/app_spacing_lg" />
                    <com.google.android.material.textfield.TextInputLayout
                style="@style/App.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <AutoCompleteTextView
                    android:id="@+id/actvProfileVibPattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:cursorVisible="false" />

            </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProfilePreviewVib"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Preview" android:layout_marginTop="@dimen/app_spacing_lg"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Vibration timeout -->
            <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/app_card_padding_lg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Vibration Timeout"
                            android:textSize="@dimen/app_text_size_lg" android:textColor="@color/app_text_title"
                            android:fontFamily="sans-serif-medium" />
                        <TextView android:id="@+id/tvProfileVibTimeoutLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="1 min" android:textSize="@dimen/app_text_size_md"
                            android:textColor="@color/app_text_label" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderProfileVibTimeout"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:valueFrom="0" android:valueTo="900" android:stepSize="15" android:value="60"
                        app:thumbColor="@color/colorPrimary" app:trackColorActive="@color/colorPrimary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="No timeout" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15 min" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ ACTION (Notice profile only) ══════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutActionSection"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="ACTION"
                    android:textSize="@dimen/app_text_size_sm" android:letterSpacing="0.12"
                    android:textColor="@color/app_text_label" android:fontFamily="sans-serif-medium"
                    android:paddingBottom="6dp" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="One-shot sounds played at phase transitions. Volume applied at system level."
                    android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_body"
                    android:paddingBottom="12dp" />

                <!-- Execute sound -->
                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/app_spacing_lg" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="@dimen/app_card_padding_lg">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Execute Sound"
                                    android:textSize="@dimen/app_text_size_lg" android:textColor="@color/app_text_title"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView android:id="@+id/tvExecuteSoundName"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="System notification tone"
                                    android:textSize="@dimen/app_text_size_md" android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs" />
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPickExecuteSound"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Choose"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Played once when execute time starts"
                            android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_body"
                            android:layout_marginTop="@dimen/app_spacing_md" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Wait sound -->
                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/app_spacing_lg" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="@dimen/app_card_padding_lg">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Wait Sound"
                                    android:textSize="@dimen/app_text_size_lg" android:textColor="@color/app_text_title"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView android:id="@+id/tvWaitSoundName"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="System notification tone"
                                    android:textSize="@dimen/app_text_size_md" android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs" />
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPickWaitSound"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Choose"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Played once when wait time begins"
                            android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_body"
                            android:layout_marginTop="@dimen/app_spacing_md" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action volume -->
                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="@dimen/app_card_padding_lg">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Action Volume"
                                android:textSize="@dimen/app_text_size_lg" android:textColor="@color/app_text_title"
                                android:fontFamily="sans-serif-medium" />
                            <TextView android:id="@+id/tvActionVolumeLabel"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="80%" android:textSize="@dimen/app_text_size_md"
                                android:textColor="@color/app_text_label" android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="System notification volume for execute &amp; wait sounds. Restored after playback."
                            android:textSize="@dimen/app_text_size_sm" android:textColor="@color/app_text_body"
                            android:layout_marginTop="@dimen/app_spacing_cs" android:layout_marginBottom="@dimen/app_spacing_md" />
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderActionVolume"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:valueFrom="0" android:valueTo="100" android:stepSize="5" android:value="80"
                            app:thumbColor="@color/colorPrimary" app:trackColorActive="@color/colorPrimary" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0%" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textSize="@dimen/app_text_size_xs" android:textColor="@color/app_text_hint"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout><!-- end layoutActionSection -->

        </LinearLayout>
    </ScrollView>
</LinearLayout>
