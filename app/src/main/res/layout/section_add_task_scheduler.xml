<?xml version="1.0" encoding="utf-8"?>
<!--
  Scheduler Class card — class dropdown, description, stop-class warning,
  and two conditional sub-sections included from:

    section_add_task_scheduler_dl.xml  — SCHED_DEADLINE fields (layoutDlFields)
    section_add_task_scheduler_rt.xml  — SCHED_FIFO/RR fields  (layoutRtFields)

  Both sub-sections are hidden by default.
  AddTaskSchedulerSection.kt shows the relevant one when the spinner selection
  changes to dl_sched_class or rt_sched_class.
-->
<com.google.android.material.card.MaterialCardView
    style="@style/App.Card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/app_card_margin_horizontal"
    android:layout_marginEnd="@dimen/app_card_margin_horizontal"
    android:layout_marginTop="@dimen/app_card_margin_top"
    android:layout_marginBottom="@dimen/app_card_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/app_card_padding_md">

        <!-- Header row: title + subtitle + toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scheduler Class"
                    android:textSize="@dimen/app_text_size_md"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/app_text_label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Override Linux scheduler class (default: EEVDF / fair)"
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_hint"
                    android:layout_marginTop="@dimen/app_spacing_cs" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSchedulerEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Expanded fields: shown when toggle is ON -->
        <LinearLayout
            android:id="@+id/layoutSchedulerFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/app_spacing_lg"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_divider"
                android:background="@color/app_divider_inner"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scheduler Class"
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_text_tertiary"
                android:layout_marginBottom="@dimen/app_spacing_sm" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/App.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <AutoCompleteTextView
                    android:id="@+id/actvSchedulerClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:cursorVisible="false" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Class description — updated by spinner listener -->
            <TextView
                android:id="@+id/tvSchedulerClassDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_text_tertiary"
                android:background="@color/app_surface_subtle"
                android:padding="@dimen/app_card_padding_sm"
                android:layout_marginTop="@dimen/app_spacing_md" />

            <!-- Warning banner — shown only for stop_sched_class -->
            <TextView
                android:id="@+id/tvSchedulerWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠ stop_sched_class is a kernel-internal class for CPU migration tasks. Assigning it to user tasks may cause undefined behaviour."
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_warning_text"
                android:background="@color/app_warning_background"
                android:padding="@dimen/app_card_padding_sm"
                android:layout_marginTop="@dimen/app_spacing_md"
                android:visibility="gone" />

            <!-- SCHED_DEADLINE sub-section -->
            <include layout="@layout/section_add_task_scheduler_dl" />

            <!-- SCHED_FIFO / SCHED_RR sub-section -->
            <include layout="@layout/section_add_task_scheduler_rt" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
