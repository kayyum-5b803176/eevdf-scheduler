<?xml version="1.0" encoding="utf-8"?>
<!--
  Load Factor card — human effort model with 3 NASA-TLX-derived sliders.

  switchLoadFactorEnabled — toggle; OFF = inherited from parent (or default 50),
                            ON  = shows the three sliders + combined preview.

  tvLoadFactorAutoLabel   — "(auto)" badge shown when switch is OFF, communicating
                            that the value is inherited.  Hidden when switch is ON.

  layoutLoadFactorSliders — container shown/hidden by the switch.
    sliderCognitive / tvCognitiveValue — NASA-TLX Mental Demand (1–7).
    sliderPhysical  / tvPhysicalValue  — NASA-TLX Physical Demand (1–7).
    sliderEmotional / tvEmotionalValue — NASA-TLX Frustration / Emotional weight (1–7).
    tvLoadFactorCombined               — live "Combined Load: X / 100" preview.

  Combined formula (matches TaskLoadFactor.compute):
    loadFactor = ((cognitive + physical + emotional − 3) / 18) × 100
    1,1,1 →  0    4,4,4 → 50 (default)    7,7,7 → 100
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header row: title + subtitle on the left, toggle on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLoadFactorTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Load Factor"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary" />

                    <!-- (auto) badge: visible when switch is OFF -->
                    <TextView
                        android:id="@+id/tvLoadFactorAutoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="(auto)"
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary"
                        android:visibility="visible" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Human effort while this task runs"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLoadFactorEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Sliders: shown when toggle is ON -->
        <LinearLayout
            android:id="@+id/layoutLoadFactorSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_divider"
                android:background="#E0E0E0"
                android:layout_marginBottom="14dp" />

            <!-- ── Cognitive ───────────────────────────────────────────── -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cognitive"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mental concentration, analysis, decisions"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCognitiveValue"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:gravity="end" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCognitive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:valueFrom="1"
                android:valueTo="7"
                android:stepSize="1"
                android:value="4"
                app:labelBehavior="gone" />

            <!-- ── Physical ────────────────────────────────────────────── -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Physical"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bodily exertion, movement, stamina"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPhysicalValue"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:gravity="end" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPhysical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:valueFrom="1"
                android:valueTo="7"
                android:stepSize="1"
                android:value="4"
                app:labelBehavior="gone" />

            <!-- ── Emotional ───────────────────────────────────────────── -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emotional"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Stress, stakes, pressure, emotional weight"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmotionalValue"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:gravity="end" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderEmotional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:valueFrom="1"
                android:valueTo="7"
                android:stepSize="1"
                android:value="4"
                app:labelBehavior="gone" />

            <!-- ── Combined preview ────────────────────────────────────── -->

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_divider"
                android:background="#E0E0E0"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvLoadFactorCombined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Combined Load: 50 / 100"
                android:textSize="13sp"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:gravity="end" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
