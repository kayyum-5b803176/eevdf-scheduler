<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/displaySettingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />


    <ScrollView style="@style/App.PageScroll">

        <LinearLayout style="@style/App.PageContent">

            <!-- ══ TAB: ui ══════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/tabContentUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

            <!-- ══ APPEARANCE ═════════════════════════════════════════════ -->

            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout style="@style/App.SettingsCard.Body">

                    <TextView style="@style/App.SwitchRow"
                        android:text="Dark Mode" />

                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="Choose between light theme, dark theme, or follow the system setting."
                        android:layout_marginBottom="@dimen/app_spacing_xl" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/darkModeToggleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDarkModeLight"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDarkModeDark"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dark" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDarkModeSystem"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="System" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ SIMPLE MODE ═════════════════════════════════════════════ -->
            <View style="@style/App.Divider.Section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout style="@style/App.SettingsCard.Body">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSimpleMode"
                        style="@style/App.SwitchRow"
                        android:text="Simple Mode" />

                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="Unselected cards show name only. Tap to expand. Running task stays expanded." />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ UNIT FORMAT ══════════════════════════════════════════════ -->
            <View style="@style/App.Divider.Section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout style="@style/App.SettingsCard.Body">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchUnitFormat"
                        style="@style/App.SwitchRow"
                        android:text="SI Unit Format" />

                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="VRT, VDL, Runs, TRT use SI suffixes. Floats: 88191 → 88.19K. Integers: 1800 → 1.8K. Time: 3d 28h 3s → 3d 28h." />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ OVERLAY INTENT ═══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout style="@style/App.SettingsCard.Body">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchOverlayIntent"
                        style="@style/App.SwitchRow"
                        android:text="Overlay Intent" />

                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="Don't show the full-screen timer-expiry overlay while one of the selected apps is open. The alarm still rings and shows a notification. Hardware keys (Stop / Restart) work only while the overlay is shown, so they are inactive on these apps."
                        android:lineSpacingMultiplier="1.3" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/app_divider"
                        android:background="@color/infoBoxBackground"
                        android:layout_marginTop="@dimen/app_spacing_xl" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchOverlayIntentLockOnly"
                        style="@style/App.SwitchRow"
                        android:text="Show intent only on lock screen"
                        android:layout_marginTop="@dimen/app_spacing_lg" />

                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="When on, the overlay appears only while the device is locked (like the Clock app). On an unlocked device the alarm just rings with a notification. This overrides the app list below."
                        android:lineSpacingMultiplier="1.3" />

                    <LinearLayout
                        android:id="@+id/rowOverlayIntentApps"
                        style="@style/App.Row.Nav.FlushHorizontal"
                        android:paddingTop="@dimen/app_card_padding_md"
                        android:paddingBottom="@dimen/app_spacing_sm"
                        android:minHeight="0dp">

                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="Configure apps" />
                            <TextView
                                android:id="@+id/tvOverlayIntentApps"
                                style="@style/App.Row.Subtitle"
                                android:layout_width="match_parent"
                                android:text="No apps selected" />
                        </LinearLayout>

                        <TextView style="@style/App.Text.Chevron"
                            android:text="&#8250;" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ CARD HEIGHT ══════════════════════════════════════════════ -->
            <View style="@style/App.Divider.Section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout style="@style/App.SettingsCard.Body">

                    <LinearLayout style="@style/App.ValueRow">
                        <TextView style="@style/App.ValueRow.Label"
                            android:layout_width="@dimen/app_label_slot_md"
                            android:layout_weight="0"
                            android:text="Card Height" />
                        <TextView
                            android:id="@+id/tvCardHeightValue"
                            style="@style/App.ValueRow.Value"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="5 (Default)" />
                    </LinearLayout>

                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="Adjusts card padding. Font size unchanged."
                        android:layout_marginTop="@dimen/app_spacing_cs"
                        android:layout_marginBottom="@dimen/app_spacing_md" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderCardHeight"
                        style="@style/App.Slider"
                        android:layout_marginTop="0dp"
                        android:valueFrom="1"
                        android:valueTo="5"
                        android:stepSize="1"
                        android:value="5" />

                    <LinearLayout style="@style/App.Slider.CaptionRow">
                        <TextView style="@style/App.Slider.CaptionStart"
                            android:text="Compact" />
                        <TextView style="@style/App.Slider.CaptionEnd"
                            android:text="Default" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ WINDOW CALIBRATE ═════════════════════════════════════════ -->
            <View style="@style/App.Divider.Section" />

            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_card_gap"
                android:layout_marginEnd="@dimen/app_card_gap"
                android:layout_marginTop="@dimen/app_card_gap"
                android:layout_marginBottom="@dimen/app_card_gap">

                <LinearLayout style="@style/App.SettingsCard.Body">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoAdjust"
                        style="@style/App.SwitchRow"
                        android:text="Window Calibrate" />

                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="Hides stat rows on FLOAT / MINI profiles. NORMAL keeps full layout." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/app_divider"
                        android:layout_marginTop="@dimen/app_spacing_lg"
                        android:layout_marginBottom="@dimen/app_spacing_lg"
                        android:background="@color/divider" />

                    <!-- Live window stats -->
                    <TextView
                        android:id="@+id/tvWindowLiveStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="reading…"
                        android:textSize="@dimen/app_text_size_xs"
                        android:textColor="@color/quotaTextExceeded"
                        android:fontFamily="monospace"
                        android:background="@color/infoBoxBackground"
                        android:paddingStart="@dimen/app_spacing_md"
                        android:paddingEnd="@dimen/app_spacing_md"
                        android:paddingTop="@dimen/app_spacing_sm"
                        android:paddingBottom="@dimen/app_spacing_sm" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/app_divider"
                        android:layout_marginTop="@dimen/app_spacing_lg"
                        android:layout_marginBottom="@dimen/app_spacing_lg"
                        android:background="@color/divider" />

                    <!-- Calibrate Profiles header -->
                    <TextView style="@style/App.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CALIBRATE PROFILES"
                        android:layout_marginBottom="@dimen/app_spacing_md" />

                    <!-- 3-column profile picker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- FLOAT profile card -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/App.Card"
                            android:id="@+id/cardCalFloat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="@dimen/app_card_gap"
                            android:layout_marginEnd="@dimen/app_card_gap"
                            android:layout_marginTop="@dimen/app_card_gap"
                            android:layout_marginBottom="@dimen/app_card_gap">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="@dimen/app_card_padding_sm">
                                <TextView style="@style/App.Text.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="FLOAT" />
                                <TextView
                                    android:id="@+id/tvCalFloatDims"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="not set"
                                    android:textSize="@dimen/app_text_size_xs"
                                    android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- NORMAL profile card -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/App.Card"
                            android:id="@+id/cardCalNormal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="@dimen/app_card_gap"
                            android:layout_marginEnd="@dimen/app_card_gap"
                            android:layout_marginTop="@dimen/app_card_gap"
                            android:layout_marginBottom="@dimen/app_card_gap">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="@dimen/app_card_padding_sm">
                                <TextView style="@style/App.Text.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NORMAL" />
                                <TextView
                                    android:id="@+id/tvCalNormalDims"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="not set"
                                    android:textSize="@dimen/app_text_size_xs"
                                    android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- MINI profile card -->
                        <com.google.android.material.card.MaterialCardView
                            style="@style/App.Card"
                            android:id="@+id/cardCalMini"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="@dimen/app_card_gap"
                            android:layout_marginEnd="@dimen/app_card_gap"
                            android:layout_marginTop="@dimen/app_card_gap"
                            android:layout_marginBottom="@dimen/app_card_gap">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="@dimen/app_card_padding_sm">
                                <TextView style="@style/App.Text.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MINI" />
                                <TextView
                                    android:id="@+id/tvCalMiniDims"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="not set"
                                    android:textSize="@dimen/app_text_size_xs"
                                    android:textColor="@color/app_text_body"
                                    android:layout_marginTop="@dimen/app_spacing_cs"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Hint -->
                    <TextView style="@style/App.SwitchRow.Description"
                        android:text="Tap to record · Long-press to clear"
                        android:layout_marginTop="@dimen/app_spacing_md" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout><!-- end tabContentUi -->

            <!-- ══ TAB: render ══════════════════════════════════════════════
                 A card list, same pattern as the main Settings page. Each
                 card here navigates to its own sub-screen. If this list is
                 ever empty, the tab shows a genuinely blank content area —
                 no placeholder message, no empty-state illustration.
            ══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/tabContentRender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- NavCard: Layout — (0) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_card_gap"
                    android:layout_marginEnd="@dimen/app_card_gap"
                    android:layout_marginTop="@dimen/app_card_gap"
                    android:layout_marginBottom="@dimen/app_card_gap">
                    <LinearLayout
                        android:id="@+id/rowLayoutDemo"
                        style="@style/App.Row.Nav">
                        <LinearLayout style="@style/App.Row.TextBlock">
                            <TextView style="@style/App.Row.Title"
                                android:text="layout" />
                        </LinearLayout>
                        <TextView style="@style/App.Text.Chevron"
                            android:text="&#8250;" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout><!-- end tabContentRender -->

        </LinearLayout>
    </ScrollView>
</LinearLayout>
