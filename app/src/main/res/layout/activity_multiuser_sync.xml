<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/multiUserSyncToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screenBackground"
        android:elevation="4dp"
        app:titleTextColor="@color/app_text_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/app_text_label"
        app:tabIndicatorColor="@color/app_text_label"
        app:tabTextColor="@color/app_text_body" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/app_card_padding_xl"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ── Enable toggle ────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/app_spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable Multiuser Sync"
                        android:textSize="@dimen/app_text_size_lg"
                        android:textColor="@color/app_text_title"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Share task &amp; timer state in real-time with other users"
                        android:textSize="@dimen/app_text_size_sm"
                        android:textColor="@color/app_text_body"
                        android:layout_marginTop="@dimen/app_spacing_cs" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSyncEnable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ── Divider ───────────────────────────────────────────────────── -->


            <!-- ── Sync status line ──────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sync disabled"
                android:textSize="@dimen/app_text_size_md"
                android:textColor="@color/app_text_body"
                android:layout_marginBottom="@dimen/app_spacing_xl" />

            <!-- ── Folder row (hidden when sync disabled) ────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutSyncFolderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sync Folder"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_title"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All devices must point to the same folder (e.g. a shared network drive or cloud-synced directory)."
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_body"
                    android:layout_marginBottom="@dimen/app_spacing_md" />

                <!-- Current folder path display -->
                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/app_spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/app_card_padding_lg">

                        <ImageView
                            android:layout_width="@dimen/app_icon_sm"
                            android:layout_height="@dimen/app_icon_sm"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:layout_marginEnd="@dimen/app_spacing_md"
                            android:tint="@color/textSecondary" />

                        <TextView
                            android:id="@+id/tvSyncFolderPath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No folder selected"
                            android:textSize="@dimen/app_text_size_md"
                            android:textColor="@color/app_text_title"
                            android:singleLine="true"
                            android:ellipsize="start" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickSyncFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/app_spacing_md"
                    android:text="Choose Sync Folder"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_divider"
                    android:background="@color/divider"
                    android:layout_marginTop="@dimen/app_spacing_md"
                    android:layout_marginBottom="@dimen/app_spacing_xl" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manual Sync"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_title"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sync happens automatically every 3 seconds. Use this to force an immediate sync."
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_body"
                    android:layout_marginBottom="@dimen/app_spacing_md" />

                <!-- ── Write stats card ──────────────────────────────────────── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/app_divider"
                    android:background="@color/divider"
                    android:layout_marginTop="@dimen/app_spacing_md"
                    android:layout_marginBottom="@dimen/app_spacing_xl" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Storage Write Stats"
                    android:textSize="@dimen/app_text_size_md"
                    android:textColor="@color/app_text_title"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/app_spacing_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Page-diff mode writes only changed 4 KB blocks. Green = working efficiently."
                    android:textSize="@dimen/app_text_size_sm"
                    android:textColor="@color/app_text_body"
                    android:layout_marginBottom="@dimen/app_spacing_md" />

                <com.google.android.material.card.MaterialCardView
        style="@style/App.Card"
                    android:id="@+id/cardWriteStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/app_spacing_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/app_card_padding_lg">

                        <!-- Access mode badge row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/app_spacing_lg">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Access mode"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body" />

                            <TextView
                                android:id="@+id/tvAccessMode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_title"
                                android:fontFamily="sans-serif-medium"
                                android:paddingStart="@dimen/app_spacing_md"
                                android:paddingEnd="@dimen/app_spacing_md"
                                android:paddingTop="@dimen/app_spacing_cs"
                                android:paddingBottom="@dimen/app_spacing_cs"
                                android:background="@drawable/badge_bg"
                                android:backgroundTint="@color/syncDotDisabled" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/app_divider"
                            android:background="@color/divider"
                            android:layout_marginBottom="@dimen/app_spacing_lg" />

                        <!-- Last export row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/app_spacing_md">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Last export"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body" />

                            <TextView
                                android:id="@+id/tvLastExportTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_title" />
                        </LinearLayout>

                        <!-- DB size row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/app_spacing_md">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="DB size"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body" />

                            <TextView
                                android:id="@+id/tvDbSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_title" />
                        </LinearLayout>

                        <!-- Written / skipped row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/app_spacing_md">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Last write"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body" />

                            <TextView
                                android:id="@+id/tvBytesWritten"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_title" />
                        </LinearLayout>

                        <!-- Pages written / skipped (only shown in direct mode) -->
                        <LinearLayout
                            android:id="@+id/rowPageStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/app_spacing_md"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Pages written / skipped"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body" />

                            <TextView
                                android:id="@+id/tvPageStats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_title" />
                        </LinearLayout>

                        <!-- Write ratio progress bar -->
                        <LinearLayout
                            android:id="@+id/rowWriteRatio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="@dimen/app_spacing_md"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="@dimen/app_spacing_cs">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Write ratio"
                                    android:textSize="@dimen/app_text_size_sm"
                                    android:textColor="@color/app_text_body" />

                                <TextView
                                    android:id="@+id/tvWriteRatioPct"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textSize="@dimen/app_text_size_sm"
                                    android:textColor="@color/app_text_title" />
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/progressWriteRatio"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="@color/syncDotOK"
                                android:progressBackgroundTint="@color/divider" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/app_divider"
                            android:background="@color/divider"
                            android:layout_marginTop="@dimen/app_spacing_sm"
                            android:layout_marginBottom="@dimen/app_spacing_lg" />

                        <!-- Session totals -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="@dimen/app_spacing_md">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Session exports"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body" />

                            <TextView
                                android:id="@+id/tvSessionExports"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_title" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Session total written"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_body" />

                            <TextView
                                android:id="@+id/tvSessionTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 B"
                                android:textSize="@dimen/app_text_size_sm"
                                android:textColor="@color/app_text_title" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ── Sync Now button (also hidden when disabled) ───────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sync Now"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- ── How it works info ─────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_divider"
                android:background="@color/divider"
                android:layout_marginTop="@dimen/app_spacing_cl"
                android:layout_marginBottom="@dimen/app_spacing_xl" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/app_spacing_lg" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• All devices share a single JSON file in the sync folder.\n\n• When User A starts a timer, the change is written to the shared file within 1 second.\n\n• User B's app picks up the change within 3 seconds and updates its UI automatically.\n\n• If the sync folder is unavailable, the app continues working normally — the error icon in the toolbar will show in red.\n\n• The sync icon turns green when everything is working, and red when there is a problem."
                android:textSize="@dimen/app_text_size_sm"
                android:textColor="@color/app_text_body"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
