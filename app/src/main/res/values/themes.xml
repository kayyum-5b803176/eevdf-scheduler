<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/screenBackground</item>
        <item name="textInputStyle">@style/App.TextInput</item>
        <item name="materialAlertDialogTheme">@style/App.Dialog</item>
        <item name="materialCardViewStyle">@style/App.Card.Md</item>
        <item name="checkboxStyle">@style/App.CheckBox</item>
        <item name="radioButtonStyle">@style/App.RadioButton</item>
        <item name="shapeAppearanceSmallComponent">@style/App.Shape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/App.Shape.Medium</item>
        <item name="tabStyle">@style/App.Tab</item>
        <item name="colorControlHighlight">@color/app_ripple</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.GroupPickerDialog"
        parent="Theme.MaterialComponents.DayNight.Dialog.MinWidth" />

    <!-- ── Shape ───────────────────────────────────────────────────────────── -->

    <style name="App.Shape.Small"
        parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="App.Shape.Medium"
        parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <!-- ── TextInputLayout ─────────────────────────────────────────────────── -->

    <style name="App.TextInput"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/divider</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <style name="App.TextInput.Dropdown"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/divider</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <!-- ── Dialog ──────────────────────────────────────────────────────────── -->

    <style name="App.Dialog"
        parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/App.Shape.Medium</item>
    </style>

    <!-- ── CheckBox / RadioButton ──────────────────────────────────────────── -->

    <style name="App.CheckBox"
        parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:textSize">@dimen/app_text_size_md</item>
        <item name="android:textColor">@color/app_text_title</item>
    </style>

    <style name="App.RadioButton"
        parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:textSize">@dimen/app_text_size_md</item>
        <item name="android:textColor">@color/app_text_title</item>
    </style>

    <!-- ── TabLayout ───────────────────────────────────────────────────────── -->

    <style name="App.Tab" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextAppearance">@style/App.Tab.Text</item>
    </style>

    <style name="App.Tab.Text" parent="TextAppearance.Design.Tab">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════════
         CARD TEMPLATE SYSTEM
         ──────────────────────────────────────────────────────────────────
         Base App.Card owns shape, elevation, background, stroke.
         Each size variant sets contentPadding from the card padding scale.

         cs = custom small   4dp   (rare — very tight content)
         xs = extra small    8dp   (compact metric tiles)
         sm = small         12dp   (reserved placeholders, simple rows)
         md = medium        16dp   (standard — default card padding)
         lg = large         20dp   (form inputs, grouped controls)
         xl = extra large   24dp   (task cards, distributions, calendar)
         cl = custom large  32dp   (special wide-padding cases)

         Usage:  style="@style/App.Card.Md"
         ══════════════════════════════════════════════════════════════════ -->

    <style name="App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/app_card_corner_radius</item>
        <item name="cardElevation">@dimen/app_card_elevation</item>
        <item name="cardBackgroundColor">@color/cardBackground</item>
        <item name="strokeWidth">@dimen/app_card_stroke_width</item>
        <item name="strokeColor">@color/app_card_stroke</item>
    </style>

    <style name="App.Card.Cs" parent="App.Card">
        <item name="contentPadding">@dimen/app_card_padding_cs</item>
    </style>

    <style name="App.Card.Xs" parent="App.Card">
        <item name="contentPadding">@dimen/app_card_padding_xs</item>
    </style>

    <style name="App.Card.Sm" parent="App.Card">
        <item name="contentPadding">@dimen/app_card_padding_sm</item>
    </style>

    <style name="App.Card.Md" parent="App.Card">
        <item name="contentPadding">@dimen/app_card_padding_md</item>
    </style>

    <style name="App.Card.Lg" parent="App.Card">
        <item name="contentPadding">@dimen/app_card_padding_lg</item>
    </style>

    <style name="App.Card.Xl" parent="App.Card">
        <item name="contentPadding">@dimen/app_card_padding_xl</item>
    </style>

    <style name="App.Card.Cl" parent="App.Card">
        <item name="contentPadding">@dimen/app_card_padding_cl</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════════
         TEXT SIZE SYSTEM
         ──────────────────────────────────────────────────────────────────
         Size-based styles — define size only, default text color.
         Use these for general text where color is set separately.

         xs = extra small   10sp
         sm = small         12sp
         md = medium        14sp  ← Android standard body text
         lg = large         16sp
         xl = extra large   18sp
         cl = custom large  22sp  (chevron, large display text)

         Usage:  style="@style/App.Text.Lg"
         ══════════════════════════════════════════════════════════════════ -->

    <style name="App.Text" parent="android:TextAppearance" />

    <style name="App.Text.Xs" parent="App.Text">
        <item name="android:textSize">@dimen/app_text_size_xs</item>
        <item name="android:textColor">@color/app_text_body</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="App.Text.Sm" parent="App.Text">
        <item name="android:textSize">@dimen/app_text_size_sm</item>
        <item name="android:textColor">@color/app_text_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="App.Text.Md" parent="App.Text">
        <item name="android:textSize">@dimen/app_text_size_md</item>
        <item name="android:textColor">@color/app_text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="App.Text.Lg" parent="App.Text">
        <item name="android:textSize">@dimen/app_text_size_lg</item>
        <item name="android:textColor">@color/app_text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="App.Text.Xl" parent="App.Text">
        <item name="android:textSize">@dimen/app_text_size_xl</item>
        <item name="android:textColor">@color/app_text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="App.Text.Cl" parent="App.Text">
        <item name="android:textSize">@dimen/app_text_size_cl</item>
        <item name="android:textColor">@color/app_text_body</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════════
         SEMANTIC TEXT STYLES
         ──────────────────────────────────────────────────────────────────
         Purpose-named styles that override size and color for specific roles.
         These sit outside the size scale — they describe intent, not size.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Section divider labels — letter-spaced, primary blue, medium weight -->
    <style name="App.Text.Label">
        <item name="android:textSize">@dimen/app_text_size_sm</item>
        <item name="android:textColor">@color/app_text_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Hint / placeholder text inside form inputs -->
    <style name="App.Text.Hint">
        <item name="android:textSize">@dimen/app_text_size_sm</item>
        <item name="android:textColor">@color/app_text_hint</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Error / validation messages -->
    <style name="App.Text.Error">
        <item name="android:textSize">@dimen/app_text_size_sm</item>
        <item name="android:textColor">@color/app_color_error</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Warning banner text -->
    <style name="App.Text.Warning">
        <item name="android:textSize">@dimen/app_text_size_sm</item>
        <item name="android:textColor">@color/app_warning_text</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:background">@color/app_warning_background</item>
    </style>

    <!-- Navigation chevron › rendered as text -->
    <style name="App.Text.Chevron">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/app_text_size_cl</item>
        <item name="android:textColor">@color/app_chevron</item>
    </style>


    <!-- Base roots required by Android dot-notation implicit inheritance -->
    <style name="App" parent="android:Widget" />
    <style name="App.Row" parent="App" />

    <!-- ══════════════════════════════════════════════════════════════════════
         PAGE CHROME — scroll container and content holder
         ──────────────────────────────────────────────────────────────────
         Usage:
           <ScrollView style="@style/App.PageScroll">
               <LinearLayout style="@style/App.PageContent">
                   ...cards...
               </LinearLayout>
           </ScrollView>
         ══════════════════════════════════════════════════════════════════ -->

    <style name="App.PageScroll">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbars">vertical</item>
    </style>

    <style name="App.PageContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">@dimen/app_card_gap</item>
        <item name="android:paddingBottom">@dimen/app_card_gap</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- RecyclerView equivalent of App.PageContent, for pages that scroll a
         card list directly (e.g. the main task list) instead of wrapping a
         ScrollView + LinearLayout. Same paddingTop as App.PageContent so the
         gap above the first card matches the gap App.Card items already
         create between each other via their own symmetric marginTop/marginBottom.
         No paddingStart/paddingEnd here — left/right spacing comes entirely
         from each card's own marginStart/marginEnd (@dimen/app_card_gap), so
         both sides stay equal. paddingBottom uses app_spacing_cl to clear the FABs. -->
    <style name="App.List.Content" parent="App">
        <item name="android:paddingTop">@dimen/app_card_gap</item>
        <item name="android:paddingBottom">@dimen/app_spacing_cl</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbarStyle">outsideOverlay</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROW TEMPLATES — internal structure of rows inside cards
         ──────────────────────────────────────────────────────────────────
         App.Row.Base    — shared: horizontal, center_vertical, min height, padding
         App.Row.Nav     — navigates to child page (chevron ›)
         App.Row.Toggle  — on/off switch
         App.Row.Value   — displays current value (read-only or tappable)
         App.Row.Action  — contains a button
         App.Row.Reserved— placeholder for future settings

         Usage:
           <LinearLayout style="@style/App.Row.Nav">
               <LinearLayout style="@style/App.Row.TextBlock">
                   <TextView style="@style/App.Row.Title" android:text="..." />
                   <TextView style="@style/App.Row.Subtitle" android:text="..." />
               </LinearLayout>
               <TextView style="@style/App.Text.Chevron" android:text="›" />
           </LinearLayout>
         ══════════════════════════════════════════════════════════════════ -->

    <style name="App.Row.Base">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/app_row_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/app_row_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/app_row_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/app_row_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/app_row_padding_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="App.Row.Nav" parent="App.Row.Base" />

    <style name="App.Row.Toggle" parent="App.Row.Base" />

    <style name="App.Row.Value" parent="App.Row.Base" />

    <style name="App.Row.Action" parent="App.Row.Base">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="App.Row.Reserved" parent="App.Row.Base">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Text block inside a row — vertical container for title + subtitle -->
    <style name="App.Row.TextBlock">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Row title — primary label -->
    <style name="App.Row.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/app_text_size_lg</item>
        <item name="android:textColor">@color/app_text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Row subtitle — secondary description -->
    <style name="App.Row.Subtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/app_text_size_md</item>
        <item name="android:textColor">@color/app_text_body</item>
        <item name="android:layout_marginTop">@dimen/app_row_title_gap</item>
    </style>

    <!-- Row value — trailing current value display -->
    <style name="App.Row.ValueText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/app_text_size_md</item>
        <item name="android:textColor">@color/app_text_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginStart">@dimen/app_row_action_gap</item>
    </style>

    <!-- Divider inside a card — between rows -->
    <style name="App.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/app_divider</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- Divider between cards on a page -->
    <style name="App.Divider.Section">
        <item name="android:layout_marginBottom">@dimen/app_card_gap</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════════
         SETTINGS CARD BODY — vertical container inside a settings card
         ──────────────────────────────────────────────────────────────────
         Category: full-bleed. Every "value-style" settings card (toggle
         with description, slider with caption, value row) uses this as
         its direct MaterialCardView child instead of a hand-rolled
         LinearLayout with android:padding="@dimen/app_card_padding_lg"
         repeated at every call site. One token controls the padding for
         every settings card in the app.

         Usage:
           <com.google.android.material.card.MaterialCardView style="@style/App.Card">
               <LinearLayout style="@style/App.SettingsCard.Body">
                   ...
               </LinearLayout>
           </com.google.android.material.card.MaterialCardView>
         ══════════════════════════════════════════════════════════════════ -->

    <style name="App.SettingsCard.Body" parent="App">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/app_card_padding_lg</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════════
         SWITCH ROW — full-bleed toggle with title baked into the switch
         ──────────────────────────────────────────────────────────────────
         Category: full-bleed. This is the "SwitchMaterial spanning the
         full card width, text baked into the switch itself" pattern
         used by every settings toggle (Simple Mode, SI Unit Format,
         Overlay Intent, Haptic Feedback, Quick Action). Previously each
         call site hardcoded android:textSize / textColor / fontFamily
         on the SwitchMaterial directly, so a missed attribute (as with
         switchSvHaptic, which never set textColor or fontFamily) drifts
         silently from every other switch row in the app.

         Usage:
           <com.google.android.material.switchmaterial.SwitchMaterial
               style="@style/App.SwitchRow"
               android:text="Haptic Feedback on Buttons" />
           <TextView style="@style/App.SwitchRow.Description" android:text="..." />
         ══════════════════════════════════════════════════════════════════ -->

    <style name="App.SwitchRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/app_text_size_lg</item>
        <item name="android:textColor">@color/app_text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Description line under a switch row or value row header -->
    <style name="App.SwitchRow.Description">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/app_text_size_sm</item>
        <item name="android:textColor">@color/app_text_body</item>
        <item name="android:layout_marginTop">@dimen/app_spacing_sm</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════════
         VALUE ROW — label (reserved slot) + trailing current-value text
         ──────────────────────────────────────────────────────────────────
         Category: trailing-flexible. Used above every slider and above
         standalone read-only value displays ("Sound Timeout — 1 min",
         "Default Volume — 80%", "Card Height — 5 (Default)"). The
         label side MUST use a reserved slot width (@dimen/app_label_slot_*),
         not 0dp+weight — seeanchoring rationale in dimens.xml. The value
         side is wrap_content, gravity end, anchored to the far edge.

         Usage:
           <LinearLayout style="@style/App.ValueRow">
               <TextView style="@style/App.ValueRow.Label" android:text="Sound Timeout" />
               <TextView style="@style/App.ValueRow.Value" android:text="1 min" />
           </LinearLayout>
         ══════════════════════════════════════════════════════════════════ -->

    <style name="App.ValueRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Default (md) reserved-slot label. Use .Sm/.Lg siblings for short/long text. -->
    <style name="App.ValueRow.Label">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/app_text_size_lg</item>
        <item name="android:textColor">@color/app_text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="App.ValueRow.Value">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/app_value_row_gap</item>
        <item name="android:textSize">@dimen/app_text_size_md</item>
        <item name="android:textColor">@color/app_text_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">end</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════════
         SLIDER BLOCK — slider + min/max caption row
         ──────────────────────────────────────────────────────────────────
         Category: full-bleed. Pairs with App.ValueRow above it (the
         value shown updates as the slider moves). The caption row
         beneath uses the same reserved-slot discipline: the min label
         is 0dp+weight so the max label is always right-anchored,
         regardless of min/max text length ("0%"..."100%" vs
         "No timeout"..."15 min").

         Usage:
           <LinearLayout style="@style/App.ValueRow"> ...label + value... </LinearLayout>
           <com.google.android.material.slider.Slider style="@style/App.Slider" ... />
           <LinearLayout style="@style/App.Slider.CaptionRow">
               <TextView style="@style/App.Slider.CaptionStart" android:text="0%" />
               <TextView style="@style/App.Slider.CaptionEnd" android:text="100%" />
           </LinearLayout>
         ══════════════════════════════════════════════════════════════════ -->

    <style name="App.Slider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/app_slider_top_gap</item>
        <item name="thumbColor">@color/colorPrimary</item>
        <item name="trackColorActive">@color/colorPrimary</item>
    </style>

    <style name="App.Slider.CaptionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginTop">@dimen/app_slider_caption_gap</item>
    </style>

    <style name="App.Slider.CaptionStart">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/app_text_size_xs</item>
        <item name="android:textColor">@color/app_text_hint</item>
    </style>

    <style name="App.Slider.CaptionEnd">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/app_text_size_xs</item>
        <item name="android:textColor">@color/app_text_hint</item>
    </style>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROW STATE VARIANTS — named, not improvised
         ──────────────────────────────────────────────────────────────────
         Pre-defined variants for the cases that otherwise get bent
         ad hoc: a row that needs a trailing icon-button instead of a
         chevron, and a row disabled pending a feature flag. Add new
         variants here — centrally — rather than nudging an instance
         with an extra wrapper or inline attribute.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- App.Row.Nav with a fixed icon-button instead of a chevron (e.g. a
         card row that opens a picker via icon rather than navigating) -->
    <style name="App.Row.Nav.IconTrailing" parent="App.Row.Nav" />

    <!-- App.Row.Nav nested inside a card body/section that already
         supplies its own horizontal inset (e.g. below a switch row in
         the same card). Keeps App.Row.Nav's vertical padding tokens
         so the row still owns its own top/bottom rhythm — only the
         horizontal padding is zeroed, and it's zeroed once, here,
         rather than at every call site. -->
    <style name="App.Row.Nav.FlushHorizontal" parent="App.Row.Nav">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <!-- App.Row.Reserved that is disabled-looking (lower alpha) rather
         than the plain "no settings yet" placeholder -->
    <style name="App.Row.Reserved.Disabled" parent="App.Row.Reserved">
        <item name="android:alpha">0.5</item>
    </style>

    <!-- "Flush" variants — for a row nested inside App.SettingsCard.Body,
         which already supplies the card's own padding. Without these,
         App.Row.Base's own horizontal/vertical padding would double up
         with the parent card's padding, so call sites were zeroing all
         four padding attributes ad hoc at every use. Named here once
         instead: still gets center_vertical + min-height + background,
         just no padding of its own and no forced min-height, since the
         surrounding card body already reserves that space. -->
    <style name="App.Row.Toggle.Flush" parent="App.Row.Toggle">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="App.Row.Value.Flush" parent="App.Row.Value">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>
