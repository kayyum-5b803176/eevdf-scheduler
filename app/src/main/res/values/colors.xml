<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         COLOUR PALETTE  —  41 tokens  (Material Design reference)
         ──────────────────────────────────────────────────────────────────
         Chromatic   12 hues × 3 slots  =  36 tokens
         Achromatic   grey × 3 slots   =   3 tokens
         Absolutes    white + black     =   2 tokens
         ──────────────────────────────────────────────────────────────────
         Slots map to Material Design scale numbers:
           lt  =  Material 200   (light tint — background safe)
           nd  =  Material 500   (normal — standard identity color)
           dk  =  Material 800   (dark — text and strong accent)
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── Absolutes ──────────────────────────────────────────────────────── -->
    <color name="app_white">#FFFFFF</color>
    <color name="app_black">#000000</color>

    <!-- ── Grey  (Material Grey) ─────────────────────────────────────────── -->
    <color name="app_grey_lt">#EEEEEE</color>   <!-- 200 -->
    <color name="app_grey_nd">#9E9E9E</color>   <!-- 500 -->
    <color name="app_grey_dk">#424242</color>   <!-- 800 -->

    <!-- ── Red  (Material Red) ───────────────────────────────────────────── -->
    <color name="app_red_lt">#EF9A9A</color>    <!-- 200 -->
    <color name="app_red_nd">#F44336</color>    <!-- 500 -->
    <color name="app_red_dk">#C62828</color>    <!-- 800 -->

    <!-- ── Orange  (Material Orange) ─────────────────────────────────────── -->
    <color name="app_orange_lt">#FFCC80</color>  <!-- 200 -->
    <color name="app_orange_nd">#FF9800</color>  <!-- 500 -->
    <color name="app_orange_dk">#E65100</color>  <!-- 800 -->

    <!-- ── Yellow  (Material Yellow) ─────────────────────────────────────── -->
    <color name="app_yellow_lt">#FFF59D</color>  <!-- 200 -->
    <color name="app_yellow_nd">#FFEB3B</color>  <!-- 500 -->
    <color name="app_yellow_dk">#F57F17</color>  <!-- 800 -->

    <!-- ── Lime  (Material Lime) ──────────────────────────────────────────── -->
    <color name="app_lime_lt">#E6EE9C</color>    <!-- 200 -->
    <color name="app_lime_nd">#CDDC39</color>    <!-- 500 -->
    <color name="app_lime_dk">#827717</color>    <!-- 800 -->

    <!-- ── Green  (Material Green) ───────────────────────────────────────── -->
    <color name="app_green_lt">#A5D6A7</color>   <!-- 200 -->
    <color name="app_green_nd">#4CAF50</color>   <!-- 500 -->
    <color name="app_green_dk">#2E7D32</color>   <!-- 800 -->

    <!-- ── Mint  (Material Teal) ─────────────────────────────────────────── -->
    <color name="app_mint_lt">#80CBC4</color>    <!-- 200 -->
    <color name="app_mint_nd">#009688</color>    <!-- 500 -->
    <color name="app_mint_dk">#00695C</color>    <!-- 800 -->

    <!-- ── Cyan  (Material Cyan) ─────────────────────────────────────────── -->
    <color name="app_cyan_lt">#80DEEA</color>    <!-- 200 -->
    <color name="app_cyan_nd">#00BCD4</color>    <!-- 500 -->
    <color name="app_cyan_dk">#00838F</color>    <!-- 800 -->

    <!-- ── Azure  (Material Blue) ────────────────────────────────────────── -->
    <color name="app_azure_lt">#90CAF9</color>   <!-- 200 -->
    <color name="app_azure_nd">#2196F3</color>   <!-- 500 -->
    <color name="app_azure_dk">#1565C0</color>   <!-- 800 — app primary -->

    <!-- ── Blue  (Material Indigo) ───────────────────────────────────────── -->
    <color name="app_blue_lt">#9FA8DA</color>    <!-- 200 -->
    <color name="app_blue_nd">#3F51B5</color>    <!-- 500 -->
    <color name="app_blue_dk">#283593</color>    <!-- 800 -->

    <!-- ── Violet  (Material Purple) ─────────────────────────────────────── -->
    <color name="app_violet_lt">#CE93D8</color>  <!-- 200 -->
    <color name="app_violet_nd">#9C27B0</color>  <!-- 500 -->
    <color name="app_violet_dk">#6A1B9A</color>  <!-- 800 -->

    <!-- ── Magenta  (Material Pink) ──────────────────────────────────────── -->
    <color name="app_magenta_lt">#F48FB1</color> <!-- 200 -->
    <color name="app_magenta_nd">#E91E63</color> <!-- 500 -->
    <color name="app_magenta_dk">#AD1457</color> <!-- 800 -->

    <!-- ── Rose  (Material Deep Orange) ──────────────────────────────────── -->
    <color name="app_rose_lt">#FFAB91</color>    <!-- 200 -->
    <color name="app_rose_nd">#FF5722</color>    <!-- 500 -->
    <color name="app_rose_dk">#BF360C</color>    <!-- 800 -->

    <!-- ══════════════════════════════════════════════════════════════════════
         SEMANTIC ALIASES
         Purpose-named tokens. Layouts reference only these.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Android theme -->
    <color name="colorPrimary">@color/app_azure_dk</color>
    <color name="colorPrimaryDark">@color/app_blue_dk</color>
    <color name="colorAccent">@color/app_orange_nd</color>

    <!-- Surfaces -->
    <color name="screenBackground">@color/app_grey_lt</color>
    <color name="cardBackground">@color/app_white</color>
    <color name="headerBackground">@color/app_azure_dk</color>
    <color name="statsBarBackground">@color/app_blue_dk</color>
    <color name="infoBoxBackground">@color/app_grey_lt</color>

    <!-- Text hierarchy -->
    <color name="textPrimary">@color/app_grey_dk</color>
    <color name="textSecondary">@color/app_grey_nd</color>
    <color name="textOnHeader">@color/app_white</color>

    <!-- Structural -->
    <color name="divider">@color/app_grey_lt</color>

    <!-- App semantic text tokens -->
    <color name="app_text_title">@color/app_grey_dk</color>
    <color name="app_text_body">@color/app_grey_nd</color>
    <color name="app_text_hint">@color/app_grey_nd</color>
    <color name="app_text_caption">@color/app_grey_nd</color>
    <color name="app_text_tertiary">@color/app_grey_dk</color>
    <color name="app_text_label">@color/app_azure_dk</color>
    <color name="app_chevron">@color/app_grey_nd</color>
    <color name="app_divider_inner">@color/app_grey_lt</color>
    <color name="app_surface_subtle">@color/app_grey_lt</color>
    <color name="app_card_stroke">@color/app_grey_lt</color>
    <color name="app_color_error">@color/app_red_nd</color>
    <color name="app_warning_background">@color/app_orange_lt</color>
    <color name="app_warning_text">@color/app_orange_dk</color>
    <color name="app_success_text">@color/app_green_dk</color>
    <color name="app_stat_accent">@color/app_violet_dk</color>
    <color name="app_ripple">#1A1565C0</color>

    <!-- ══════════════════════════════════════════════════════════════════════
         TASK CARD STATE BACKGROUNDS
         ══════════════════════════════════════════════════════════════════ -->
    <color name="cardStateRunning">@color/app_azure_lt</color>
    <color name="cardStateDl">@color/app_red_lt</color>
    <color name="cardStateRt">@color/app_green_lt</color>
    <color name="cardStateQuotaExceeded">@color/app_yellow_lt</color>
    <color name="cardStateQuotaWarning">@color/app_orange_lt</color>
    <color name="cardStateGroup">@color/app_grey_lt</color>

    <!-- ══════════════════════════════════════════════════════════════════════
         PRIORITY RAINBOW  1 (lowest) → 7 (highest)
         Mapped across the colour wheel at nd (Material 500) level
         ══════════════════════════════════════════════════════════════════ -->
    <color name="priority1">@color/app_violet_nd</color>
    <color name="priority2">@color/app_blue_nd</color>
    <color name="priority3">@color/app_azure_nd</color>
    <color name="priority4">@color/app_green_nd</color>
    <color name="priority5">@color/app_yellow_nd</color>
    <color name="priority6">@color/app_orange_nd</color>
    <color name="priority7">@color/app_red_nd</color>

    <!-- ══════════════════════════════════════════════════════════════════════
         COMPONENT TOKENS
         ══════════════════════════════════════════════════════════════════ -->
    <color name="timerGreen">@color/app_green_nd</color>
    <color name="timerYellow">@color/app_yellow_nd</color>
    <color name="timerRed">@color/app_red_nd</color>
    <color name="timerCardBackground">@color/app_azure_dk</color>
    <color name="expiredCardBackground">@color/app_red_dk</color>
    <color name="intButtonBackground">@color/app_white</color>
    <color name="stopButtonBackground">@color/app_white</color>
    <color name="stopButtonText">@color/app_red_dk</color>

    <color name="quotaTextExceeded">@color/app_red_nd</color>
