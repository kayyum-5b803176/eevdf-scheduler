    <color name="quotaTextNormal">@color/app_grey_nd</color>
    <color name="quotaBarExceeded">@color/app_red_nd</color>
    <color name="quotaBarWarning">@color/app_orange_nd</color>
    <color name="quotaBarNormal">@color/app_green_nd</color>

    <color name="bannerDl">@color/app_red_dk</color>
    <color name="bannerRt">@color/app_orange_dk</color>
    <color name="bannerStop">@color/app_red_dk</color>
    <color name="bannerIdle">@color/app_grey_nd</color>

    <color name="pillDlActive">@color/app_orange_dk</color>
    <color name="pillRtActive">@color/app_green_dk</color>
    <color name="pillInactive">@color/app_grey_nd</color>

    <color name="rankDl">@color/app_azure_dk</color>
    <color name="rankRt">@color/app_green_dk</color>

    <color name="pinActive">@color/app_orange_nd</color>
