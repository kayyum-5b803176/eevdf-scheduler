    <color name="bannerStop">@color/app_red_dk</color>
    <color name="bannerIdle">@color/app_grey_nd</color>

    <color name="pillDlActive">@color/app_orange_dk</color>
    <color name="pillRtActive">@color/app_green_dk</color>
    <color name="pillInactive">@color/app_grey_nd</color>

    <color name="rankDl">#1565C0</color>
    <color name="rankRt">@color/app_green_dk</color>

    <color name="pinActive">@color/app_orange_nd</color>
