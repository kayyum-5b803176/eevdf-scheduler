<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         COLOUR PALETTE  —  41 systematic tokens
         ──────────────────────────────────────────────────────────────────
         Chromatic   12 hues × 3 slots  =  36 tokens
         Achromatic   grey × 3 slots   =   3 tokens
         Absolutes    white + black     =   2 tokens
         ──────────────────────────────────────────────────────────────────
         Hues:  30° steps around the RGB wheel (H=0°…330°, S=100%)
         Slots: lt = L 75% (light)  |  nd = L 50% (normal)  |  dk = L 25% (dark)
         Grey:  S=0%, same lightness steps
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── Absolutes ──────────────────────────────────────────────────────── -->
    <color name="app_white">#FFFFFF</color>
    <color name="app_black">#000000</color>

    <!-- ── Achromatic — Grey  (H=0° S=0%) ───────────────────────────────── -->
    <color name="app_grey_lt">#BFBFBF</color>  <!-- L=75% -->
    <color name="app_grey_nd">#808080</color>  <!-- L=50% -->
    <color name="app_grey_dk">#404040</color>  <!-- L=25% -->

    <!-- ── Red  (H=0°) ────────────────────────────────────────────────────── -->
    <color name="app_red_lt">#FF8080</color>
    <color name="app_red_nd">#FF0000</color>
    <color name="app_red_dk">#800000</color>

    <!-- ── Orange  (H=30°) ────────────────────────────────────────────────── -->
    <color name="app_orange_lt">#FFBF80</color>
    <color name="app_orange_nd">#FF8000</color>
    <color name="app_orange_dk">#804000</color>

    <!-- ── Yellow  (H=60°) ────────────────────────────────────────────────── -->
    <color name="app_yellow_lt">#FFFF80</color>
    <color name="app_yellow_nd">#FFFF00</color>
    <color name="app_yellow_dk">#808000</color>

    <!-- ── Lime  (H=90°) ──────────────────────────────────────────────────── -->
    <color name="app_lime_lt">#BFFF80</color>
    <color name="app_lime_nd">#80FF00</color>
    <color name="app_lime_dk">#408000</color>

    <!-- ── Green  (H=120°) ────────────────────────────────────────────────── -->
    <color name="app_green_lt">#80FF80</color>
    <color name="app_green_nd">#00FF00</color>
    <color name="app_green_dk">#008000</color>

    <!-- ── Mint  (H=150°) ─────────────────────────────────────────────────── -->
    <color name="app_mint_lt">#80FFBF</color>
    <color name="app_mint_nd">#00FF80</color>
    <color name="app_mint_dk">#008040</color>

    <!-- ── Cyan  (H=180°) ─────────────────────────────────────────────────── -->
    <color name="app_cyan_lt">#80FFFF</color>
    <color name="app_cyan_nd">#00FFFF</color>
    <color name="app_cyan_dk">#008080</color>

    <!-- ── Azure  (H=210°) ────────────────────────────────────────────────── -->
    <color name="app_azure_lt">#80BFFF</color>
    <color name="app_azure_nd">#0080FF</color>
    <color name="app_azure_dk">#004080</color>

    <!-- ── Blue  (H=240°) ─────────────────────────────────────────────────── -->
    <color name="app_blue_lt">#8080FF</color>
    <color name="app_blue_nd">#0000FF</color>
    <color name="app_blue_dk">#000080</color>

    <!-- ── Violet  (H=270°) ───────────────────────────────────────────────── -->
    <color name="app_violet_lt">#BF80FF</color>
    <color name="app_violet_nd">#8000FF</color>
    <color name="app_violet_dk">#400080</color>

    <!-- ── Magenta  (H=300°) ──────────────────────────────────────────────── -->
    <color name="app_magenta_lt">#FF80FF</color>
    <color name="app_magenta_nd">#FF00FF</color>
    <color name="app_magenta_dk">#800080</color>

    <!-- ── Rose  (H=330°) ─────────────────────────────────────────────────── -->
    <color name="app_rose_lt">#FF80BF</color>
    <color name="app_rose_nd">#FF0080</color>
    <color name="app_rose_dk">#800040</color>

    <!-- ══════════════════════════════════════════════════════════════════════
         SEMANTIC ALIASES
         Purpose-named tokens referencing palette slots.
         Layouts and styles use only these — never raw palette tokens.
         ──────────────────────────────────────────────────────────────────
         Existing app colors mapped to nearest palette slot:
           #1565C0 (primary blue)  → azure_dk  (#004080, H=210° closest to H=207°)
           #0D47A1 (status bar)    → azure_dk  (same slot, darker variant via semantic)
           #F44336 (error)         → red_lt    (#FF8080)
           #FFF3E0 (warning bg)    → orange_lt (#FFBF80 — same warmth)
           #E65100 (warning text)  → orange_dk (#804000)
           #1B5E20 (success text)  → green_dk  (#008000)
           #4A148C (stat accent)   → violet_dk (#400080, closest)
           #212121 (primary text)  → app_black (semantic override)
           #757575 (body text)     → app_grey_nd
           #BDBDBD (divider)       → app_grey_lt
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Android theme -->
    <color name="colorPrimary">#1565C0</color>
    <color name="colorPrimaryDark">#0D47A1</color>
    <color name="colorAccent">#FF6D00</color>

    <!-- Surfaces -->
    <color name="screenBackground">#F5F5F5</color>
    <color name="cardBackground">@color/app_white</color>
    <color name="headerBackground">#1565C0</color>
    <color name="statsBarBackground">#0D47A1</color>
    <color name="infoBoxBackground">#F5F5F5</color>

    <!-- Text hierarchy -->
    <color name="textPrimary">#212121</color>
    <color name="textSecondary">@color/app_grey_nd</color>
    <color name="textOnHeader">@color/app_white</color>

    <!-- Structural -->
    <color name="divider">@color/app_grey_lt</color>

    <!-- App semantic text tokens -->
    <color name="app_text_title">#212121</color>
    <color name="app_text_body">@color/app_grey_nd</color>
    <color name="app_text_hint">@color/app_grey_lt</color>
    <color name="app_text_caption">@color/app_grey_nd</color>
    <color name="app_text_tertiary">@color/app_grey_dk</color>
    <color name="app_text_label">#1565C0</color>
    <color name="app_chevron">@color/app_grey_nd</color>
    <color name="app_divider_inner">@color/app_grey_lt</color>
    <color name="app_surface_subtle">#F3F3F3</color>
    <color name="app_card_stroke">@color/app_grey_lt</color>
    <color name="app_color_error">@color/app_red_lt</color>
    <color name="app_warning_background">@color/app_orange_lt</color>
    <color name="app_warning_text">@color/app_orange_dk</color>
    <color name="app_success_text">@color/app_green_dk</color>
    <color name="app_stat_accent">@color/app_violet_dk</color>
    <color name="app_ripple">#1A1565C0</color>

    <!-- ══════════════════════════════════════════════════════════════════════
         TASK CARD STATE BACKGROUNDS
         ══════════════════════════════════════════════════════════════════ -->
    <color name="cardStateRunning">@color/app_azure_lt</color>
    <color name="cardStateDl">@color/app_red_lt</color>
    <color name="cardStateRt">@color/app_green_lt</color>
    <color name="cardStateQuotaExceeded">#FFFDE7</color>
    <color name="cardStateQuotaWarning">#FFF8E1</color>
    <color name="cardStateGroup">#F5F5F5</color>

    <!-- ══════════════════════════════════════════════════════════════════════
         PRIORITY RAINBOW  1 (lowest) → 7 (highest)
         ══════════════════════════════════════════════════════════════════ -->
    <color name="priority1">@color/app_violet_nd</color>
    <color name="priority2">@color/app_blue_nd</color>
    <color name="priority3">@color/app_azure_nd</color>
    <color name="priority4">@color/app_green_nd</color>
    <color name="priority5">@color/app_yellow_nd</color>
    <color name="priority6">@color/app_orange_nd</color>
    <color name="priority7">@color/app_red_nd</color>

    <!-- ══════════════════════════════════════════════════════════════════════
         COMPONENT TOKENS
         ══════════════════════════════════════════════════════════════════ -->
    <color name="timerGreen">@color/app_green_nd</color>
    <color name="timerYellow">@color/app_yellow_nd</color>
    <color name="timerRed">@color/app_red_nd</color>
    <color name="timerCardBackground">#1565C0</color>
    <color name="expiredCardBackground">@color/app_red_dk</color>
    <color name="intButtonBackground">@color/app_white</color>
    <color name="stopButtonBackground">@color/app_white</color>
