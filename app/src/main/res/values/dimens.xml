<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         SPACING SCALE
         Standard (medium) = 8dp  ·  Factor = 4dp
         ──────────────────────────────────────────────────────────────────
         cs = custom small  (free — below scale)
         xs = md − 2f = 8 − 8  =  0dp
         sm = md − 1f = 8 − 4  =  4dp
         md =            8dp        ← Android standard gap
         lg = md + 1f = 8 + 4  = 12dp
         xl = md + 2f = 8 + 8  = 16dp
         cl = custom large  (free — above scale)
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_spacing_cs">2dp</dimen>   <!-- free custom small      -->
    <dimen name="app_spacing_xs">0dp</dimen>   <!-- md − 2f  (zero kept)   -->
    <dimen name="app_spacing_sm">4dp</dimen>   <!-- md − 1f                -->
    <dimen name="app_spacing_md">8dp</dimen>   <!-- standard               -->
    <dimen name="app_spacing_lg">12dp</dimen>  <!-- md + 1f                -->
    <dimen name="app_spacing_xl">16dp</dimen>  <!-- md + 2f                -->
    <dimen name="app_spacing_cl">24dp</dimen>  <!-- free custom large      -->

    <!-- ══════════════════════════════════════════════════════════════════════
         CARD PADDING SCALE
         Standard (medium) = 16dp  ·  Factor = 4dp
         ──────────────────────────────────────────────────────────────────
         cs = custom small  (free — below scale)
         xs = md − 2f = 16 − 8  =  8dp
         sm = md − 1f = 16 − 4  = 12dp
         md =           16dp        ← Android standard padding
         lg = md + 1f = 16 + 4  = 20dp
         xl = md + 2f = 16 + 8  = 24dp
         cl = custom large  (free — above scale)
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_card_padding_cs">4dp</dimen>   <!-- free custom small  -->
    <dimen name="app_card_padding_xs">8dp</dimen>   <!-- md − 2f            -->
    <dimen name="app_card_padding_sm">12dp</dimen>  <!-- md − 1f            -->
    <dimen name="app_card_padding_md">16dp</dimen>  <!-- standard           -->
    <dimen name="app_card_padding_lg">20dp</dimen>  <!-- md + 1f            -->
    <dimen name="app_card_padding_xl">24dp</dimen>  <!-- md + 2f            -->
    <dimen name="app_card_padding_cl">32dp</dimen>  <!-- free custom large  -->

    <!-- ══════════════════════════════════════════════════════════════════════
         TEXT SIZE SCALE
         Standard (medium) = 14sp  ·  Factor = 2sp
         ──────────────────────────────────────────────────────────────────
         xs = md − 2f = 14 − 4  = 10sp
         sm = md − 1f = 14 − 2  = 12sp
         md =           14sp        ← Android standard body text
         lg = md + 1f = 14 + 2  = 16sp
         xl = md + 2f = 14 + 4  = 18sp
         cl = custom large  (free — chevron and special large text)
         Note: 11sp, 13sp have no slot — round to nearest (sm or md)
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_text_size_xs">10sp</dimen>  <!-- md − 2f              -->
    <dimen name="app_text_size_sm">12sp</dimen>  <!-- md − 1f              -->
    <dimen name="app_text_size_md">14sp</dimen>  <!-- standard             -->
    <dimen name="app_text_size_lg">16sp</dimen>  <!-- md + 1f              -->
    <dimen name="app_text_size_xl">18sp</dimen>  <!-- md + 2f              -->
    <dimen name="app_text_size_cl">22sp</dimen>  <!-- free custom large    -->

    <!-- ══════════════════════════════════════════════════════════════════════
         CHART HEIGHT SCALE
         Standard (medium) = 240dp  ·  Factor = 40dp
         ──────────────────────────────────────────────────────────────────
         cs = custom small  (free — thumbnail / embedded)
         xs = md − 2f = 240 − 80 = 160dp   (reserved)
         sm = md − 1f = 240 − 40 = 200dp   (reserved — compact)
         md =           240dp               ← standard, most charts
         lg = md + 1f = 240 + 40 = 280dp   (complex / dense charts)
         xl = md + 2f = 240 + 80 = 320dp   (reserved — full-screen)
         cl = custom large  (free — above scale)
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_chart_height_xs">160dp</dimen>  <!-- reserved          -->
    <dimen name="app_chart_height_sm">200dp</dimen>  <!-- reserved          -->
    <dimen name="app_chart_height_md">240dp</dimen>  <!-- standard          -->
    <dimen name="app_chart_height_lg">280dp</dimen>  <!-- complex / dense   -->
    <dimen name="app_chart_height_xl">320dp</dimen>  <!-- reserved          -->

    <!-- ══════════════════════════════════════════════════════════════════════
         CARD SHAPE + ELEVATION
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_card_corner_radius">12dp</dimen>
    <dimen name="app_card_elevation">4dp</dimen>
    <dimen name="app_card_stroke_width">0dp</dimen>

    <!-- ══════════════════════════════════════════════════════════════════════
         LAYOUT — page and card positioning
         (role-named, not part of the size scale)
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_page_padding_vertical">16dp</dimen>
    <!-- Uniform gap between every card and its surroundings (all 4 sides) -->
    <dimen name="app_card_gap">10dp</dimen>

    <!-- ══════════════════════════════════════════════════════════════════════
         COMPONENT — specific sizes outside the scale
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_size_row">48dp</dimen>
    <dimen name="app_size_input">56dp</dimen>
    <dimen name="app_size_bubble">52dp</dimen>
    <dimen name="app_size_alarm">64dp</dimen>
    <dimen name="app_size_calendar_row">40dp</dimen>
    <dimen name="app_btn_icon">36dp</dimen>
    <dimen name="app_btn_tag">32dp</dimen>
    <dimen name="app_day_cell">36dp</dimen>
    <dimen name="app_icon">24dp</dimen>
    <dimen name="app_icon_sm">20dp</dimen>
    <dimen name="app_divider">1dp</dimen>
    <dimen name="app_bar_notice">6dp</dimen>
    <dimen name="app_bar_track">4dp</dimen>

</resources>
