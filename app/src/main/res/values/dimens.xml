<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         SPACING SCALE
         Standard (medium) = 8dp  ·  Factor = 4dp
         ──────────────────────────────────────────────────────────────────
         cs = custom small  (free — below scale)
         xs = md − 2f = 8 − 8  =  0dp
         sm = md − 1f = 8 − 4  =  4dp
         md =            8dp        ← Android standard gap
         lg = md + 1f = 8 + 4  = 12dp
         xl = md + 2f = 8 + 8  = 16dp
         cl = custom large  (free — above scale)
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_spacing_cs">2dp</dimen>   <!-- free custom small      -->
    <dimen name="app_spacing_xs">0dp</dimen>   <!-- md − 2f  (zero kept)   -->
    <dimen name="app_spacing_sm">4dp</dimen>   <!-- md − 1f                -->
    <dimen name="app_spacing_md">8dp</dimen>   <!-- standard               -->
    <dimen name="app_spacing_lg">12dp</dimen>  <!-- md + 1f                -->
    <dimen name="app_spacing_xl">16dp</dimen>  <!-- md + 2f                -->
    <dimen name="app_spacing_cl">24dp</dimen>  <!-- free custom large      -->

    <!-- ══════════════════════════════════════════════════════════════════════
         CARD PADDING SCALE
         Standard (medium) = 16dp  ·  Factor = 4dp
         ──────────────────────────────────────────────────────────────────
         cs = custom small  (free — below scale)
         xs = md − 2f = 16 − 8  =  8dp
         sm = md − 1f = 16 − 4  = 12dp
         md =           16dp        ← Android standard padding
         lg = md + 1f = 16 + 4  = 20dp
         xl = md + 2f = 16 + 8  = 24dp
         cl = custom large  (free — above scale)
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_card_padding_cs">4dp</dimen>   <!-- free custom small  -->
    <dimen name="app_card_padding_xs">8dp</dimen>   <!-- md − 2f            -->
    <dimen name="app_card_padding_sm">12dp</dimen>  <!-- md − 1f            -->
    <dimen name="app_card_padding_md">16dp</dimen>  <!-- standard           -->
    <dimen name="app_card_padding_lg">20dp</dimen>  <!-- md + 1f            -->
    <dimen name="app_card_padding_xl">24dp</dimen>  <!-- md + 2f            -->
    <dimen name="app_card_padding_cl">32dp</dimen>  <!-- free custom large  -->

    <!-- ══════════════════════════════════════════════════════════════════════
         TEXT SIZE SCALE
         Standard (medium) = 14sp  ·  Factor = 2sp
         ──────────────────────────────────────────────────────────────────
         xs = md − 2f = 14 − 4  = 10sp
         sm = md − 1f = 14 − 2  = 12sp
         md =           14sp        ← Android standard body text
         lg = md + 1f = 14 + 2  = 16sp
         xl = md + 2f = 14 + 4  = 18sp
         cl = custom large  (free — chevron and special large text)
         Note: 11sp, 13sp have no slot — round to nearest (sm or md)
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_text_size_xs">10sp</dimen>  <!-- md − 2f              -->
    <dimen name="app_text_size_sm">12sp</dimen>  <!-- md − 1f              -->
    <dimen name="app_text_size_md">14sp</dimen>  <!-- standard             -->
    <dimen name="app_text_size_lg">16sp</dimen>  <!-- md + 1f              -->
    <dimen name="app_text_size_xl">18sp</dimen>  <!-- md + 2f              -->
    <dimen name="app_text_size_cl">22sp</dimen>  <!-- free custom large    -->

    <!-- ══════════════════════════════════════════════════════════════════════
         CHART HEIGHT SCALE
         Standard (medium) = 240dp  ·  Factor = 40dp
         ──────────────────────────────────────────────────────────────────
         cs = custom small  (free — thumbnail / embedded)
         xs = md − 2f = 240 − 80 = 160dp   (reserved)
         sm = md − 1f = 240 − 40 = 200dp   (reserved — compact)
         md =           240dp               ← standard, most charts
         lg = md + 1f = 240 + 40 = 280dp   (complex / dense charts)
         xl = md + 2f = 240 + 80 = 320dp   (reserved — full-screen)
         cl = custom large  (free — above scale)
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_chart_height_xs">160dp</dimen>  <!-- reserved          -->
    <dimen name="app_chart_height_sm">200dp</dimen>  <!-- reserved          -->
    <dimen name="app_chart_height_md">240dp</dimen>  <!-- standard          -->
    <dimen name="app_chart_height_lg">280dp</dimen>  <!-- complex / dense   -->
    <dimen name="app_chart_height_xl">320dp</dimen>  <!-- reserved          -->

    <!-- ══════════════════════════════════════════════════════════════════════
         CARD SHAPE + ELEVATION
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_card_corner_radius">12dp</dimen>
    <dimen name="app_card_elevation">4dp</dimen>
    <dimen name="app_card_stroke_width">0dp</dimen>

    <!-- ══════════════════════════════════════════════════════════════════════
         LAYOUT — page and card positioning
         (role-named, not part of the size scale)
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_page_padding_vertical">16dp</dimen>
    <!-- Uniform gap between every card and its surroundings (all 4 sides) -->
    <dimen name="app_card_gap">10dp</dimen>


    <!-- ══════════════════════════════════════════════════════════════════════
         ROW TEMPLATE — internal structure of card rows
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Minimum tap target height for any interactive row -->
    <dimen name="app_row_min_height">48dp</dimen>

    <!-- ══════════════════════════════════════════════════════════════════════
         PIECE-BOUNDARY SCALE EXTENSION — NavCard piece 0 + piece 1
         ──────────────────────────────────────────────────────────────────
         NavCard's title-row (48dp, from app_row_min_height) plus its
         subtitle piece (18dp: 14sp line + app_row_title_gap) totals 66dp,
         which is not a rung on the existing scale (0,2,4,8,12,16,24,48).
         Per the scale-alignment rule, a new rung is added by continuing
         the scale's progression rather than left off-scale: 72dp. The
         6dp shortfall (72-66) is an [S] spacer, auto-inserted by the
         template — never authored per-instance — and reuses the value
         already named as app_bar_notice rather than introducing a new
         one-off number.
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_row_boundary_rung_72">72dp</dimen>
    <dimen name="app_row_spacer_navcard_01">6dp</dimen>  <!-- = app_bar_notice, reused -->

    <!-- ══════════════════════════════════════════════════════════════════════
         PIECE-BOUNDARY SCALE EXTENSION — ToggleCard piece 0 + piece 1
         ──────────────────────────────────────────────────────────────────
         ToggleCard's title+switch row (piece 0, ~32dp — dominated by the
         switch's own intrinsic touch-target height, not the text line)
         plus its description piece (piece 1, ~20dp) plus card padding
         (40dp) totals ~92dp, which is not a rung. Continuing the ladder
         to 96dp. This rung is named in its own namespace deliberately —
         96dp also happens to be the numeric value of app_label_slot_sm
         (a label WIDTH token, unrelated), so this is a distinct token
         rather than a reused reference, to avoid two unrelated concerns
         silently tracking the same number by coincidence.
         ══════════════════════════════════════════════════════════════════ -->
    <dimen name="app_row_boundary_rung_96">96dp</dimen>
    <dimen name="app_row_spacer_togglecard_01">4dp</dimen>  <!-- = app_spacing_sm, reused -->

    <!-- ══════════════════════════════════════════════════════════════════════
         PIECE-BOUNDARY SCALE EXTENSION — ValueCard piece 0 + 1 + 2 + 3
         ──────────────────────────────────────────────────────────────────
         ValueCard's label+value row (piece 0, ~20dp) + description
         (piece 1, ~20dp) + slider (piece 2, ~48dp incl. top gap) +
         caption row (piece 3, ~16dp) + card padding (40dp) totals ~144dp,
         not a rung. Continuing the ladder to 160dp. Same deliberate
         separate-namespace reasoning as above — 160dp is also the
         numeric value of app_chart_height_xs (an unrelated chart-sizing
         token).
         ══════════════════════════════════════════════════════════════════ -->
    <dimen name="app_row_boundary_rung_160">160dp</dimen>
    <dimen name="app_row_spacer_valuecard_0123">16dp</dimen>  <!-- = app_spacing_xl, reused -->

    <!-- ══════════════════════════════════════════════════════════════════════
         PIECE-BOUNDARY SCALE EXTENSION — DropdownCard piece 0 + piece 1
         ──────────────────────────────────────────────────────────────────
         DropdownCard's title (piece 0, ~20dp) + dropdown control (piece 1,
         ~56dp, Material outlined dropdown intrinsic height) + card padding
         (40dp) totals ~116dp. This lands under the 160dp rung already
         defined for ValueCard above — reused directly, no new rung needed.
         Spacer is dedicated (44dp), since no existing token already named
         that exact value.
         ══════════════════════════════════════════════════════════════════ -->
    <dimen name="app_row_spacer_dropdowncard_01">44dp</dimen>


    <!-- Horizontal padding inside a row (start + end) -->
    <dimen name="app_row_padding_horizontal">16dp</dimen>

    <!-- Vertical padding inside a row (top + bottom) -->
    <dimen name="app_row_padding_vertical">14dp</dimen>

    <!-- Gap between title and subtitle within a row -->
    <dimen name="app_row_title_gap">2dp</dimen>

    <!-- Gap between last text element and trailing action (switch, chevron, value) -->
    <dimen name="app_row_action_gap">12dp</dimen>

    <!-- ══════════════════════════════════════════════════════════════════════
         LABEL SLOT WIDTHS — reserved, not measured
         ──────────────────────────────────────────────────────────────────
         A label placed next to a trailing-flexible element (value text,
         slider) must claim a FIXED width tier, never "however wide the
         text happens to be." If the label's box is sized to its own
         content, the trailing element's start position shifts row to
         row depending on label text length — which breaks "identical
         relative position" even though both rows use edge anchoring.

         These are widths for the LABEL side of a value-row, so the
         trailing value/slider always starts at the same relative X
         regardless of which row it's in.

         Usage: android:layout_width="@dimen/app_label_slot_md" (fixed,
         not 0dp+weight) on the TextView that is siblings with a
         trailing value — NOT on App.Row.TextBlock, which legitimately
         uses 0dp+weight because it has no trailing sibling competing
         for reserved space in App.Row.Nav/Toggle.
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_label_slot_sm">96dp</dimen>   <!-- short labels: "On/Off", "Volume" -->
    <dimen name="app_label_slot_md">140dp</dimen>  <!-- standard: "Sound Timeout" -->
    <dimen name="app_label_slot_lg">180dp</dimen>  <!-- long: "Gradual Volume Increase" -->

    <!-- ══════════════════════════════════════════════════════════════════════
         VALUE ROW — title + trailing value (read-only or slider-linked)
         Category: trailing-flexible. Docked to far edge; width is
         whatever remains after the reserved label slot, never derived
         from the trailing text's own measured width.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Gap between label slot and the trailing value text -->
    <dimen name="app_value_row_gap">12dp</dimen>

    <!-- Gap between a value-row's header line and the slider beneath it -->
    <dimen name="app_slider_top_gap">8dp</dimen>

    <!-- Gap between a slider and its min/max caption row beneath it -->
    <dimen name="app_slider_caption_gap">2dp</dimen>

    <!-- ══════════════════════════════════════════════════════════════════════
         COMPONENT — specific sizes outside the scale
         ══════════════════════════════════════════════════════════════════ -->

    <dimen name="app_size_row">48dp</dimen>
    <dimen name="app_size_input">56dp</dimen>
    <dimen name="app_size_bubble">52dp</dimen>
    <dimen name="app_size_alarm">64dp</dimen>
    <dimen name="app_size_calendar_row">40dp</dimen>
    <dimen name="app_btn_icon">36dp</dimen>
    <dimen name="app_btn_tag">32dp</dimen>
    <dimen name="app_day_cell">36dp</dimen>
    <dimen name="app_icon">24dp</dimen>
    <dimen name="app_icon_sm">20dp</dimen>
    <dimen name="app_divider">1dp</dimen>
    <dimen name="app_bar_notice">6dp</dimen>
    <dimen name="app_bar_track">4dp</dimen>

</resources>
