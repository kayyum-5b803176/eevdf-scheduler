<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ── Design Token: Interactive element heights ───────────────────────── -->

    <!-- Standard tappable row: list items, menu rows, tab rows (Material min) -->
    <dimen name="app_size_row">48dp</dimen>

    <!-- Text input / dialog header (Material TextInputLayout standard) -->
    <dimen name="app_size_input">56dp</dimen>

    <!-- Floating overlay bubble container -->
    <dimen name="app_size_bubble">52dp</dimen>

    <!-- Alarm / prominent full-width action area -->
    <dimen name="app_size_alarm">64dp</dimen>

    <!-- Calendar navigation row / secondary compact row -->
    <dimen name="app_size_calendar_row">40dp</dimen>

    <!-- ── Design Token: Square icon-button sizes ───────────────────────────── -->

    <!-- Task card action buttons (undo, delete, run etc.) -->
    <dimen name="app_btn_icon">36dp</dimen>

    <!-- Calendar day cell (width and height) -->
    <dimen name="app_day_cell">36dp</dimen>

    <!-- ── Design Token: Icon sizes ─────────────────────────────────────────── -->

    <!-- Standard icon size (Material icon grid) -->
    <dimen name="app_icon">24dp</dimen>

    <!-- Small indicator / badge icon -->
    <dimen name="app_icon_sm">20dp</dimen>

    <!-- ── Design Token: Structural dimensions ──────────────────────────────── -->

    <!-- Separator / divider line height -->
    <dimen name="app_divider">1dp</dimen>

    <!-- Thin notice / alert bar -->
    <dimen name="app_bar_notice">6dp</dimen>

    <!-- Thin progress / track bar -->
    <dimen name="app_bar_track">4dp</dimen>

    <!-- ── Design Token: Page layout ────────────────────────────────────────── -->

    <!-- Vertical breathing room at top and bottom of scroll content -->
    <dimen name="app_page_padding_vertical">16dp</dimen>

    <!-- Card inset from left and right screen edge -->
    <dimen name="app_card_margin_horizontal">10dp</dimen>

    <!-- ── Design Token: Element spacing scale (complete) ─────────────── -->
    <!-- xs=2  sm=4  md=8  lg=12  xl=16 -->
    <!-- 14dp rounds to lg · 6dp rounds to sm · 10dp warning padding rounds to card_padding_small -->

    <!-- Vertical gap above each card — mirrors marginBottom for symmetric float effect -->
    <dimen name="app_card_margin_top">12dp</dimen>

    <!-- Vertical gap between adjacent cards on the same page -->
    <dimen name="app_card_spacing">12dp</dimen>

    <!-- ── Design Token: Card template — shape ──────────────────────────────── -->

    <!-- All cards share the same corner radius -->
    <dimen name="app_card_corner_radius">12dp</dimen>

    <!-- Elevated cards (task cards, stat cards) — shadow defines the boundary -->
    <dimen name="app_card_elevation">4dp</dimen>

    <!-- Stroke on cards that sit flush (0dp = no stroke, rely on elevation) -->
    <dimen name="app_card_stroke_width">0dp</dimen>

    <!-- ── Design Token: Card template — internal padding ───────────────────── -->

    <!--
        Small   — tightest content; stat metric tiles, reserved placeholders
        Standard — default settings nav rows, simple toggles, single-action rows
        Large   — form inputs, sliders, grouped controls (edit task sections)
        Panel   — content-heavy cards; task cards, distribution lists, calendar
    -->
    <dimen name="app_card_padding_small">12dp</dimen>
    <dimen name="app_card_padding_standard">16dp</dimen>
    <dimen name="app_card_padding_large">20dp</dimen>
    <dimen name="app_card_padding_panel">24dp</dimen>

    <!-- ── Design Token: Card template — element spacing (inside card) ─────── -->

    <!--
        xs — subtitle sitting directly under a title (tight coupling)
        sm — between a description line and the next element
        md — before an action area, before a divider inside a card
    -->
    <dimen name="app_element_spacing_xs">2dp</dimen>
    <dimen name="app_element_spacing_sm">4dp</dimen>
    <dimen name="app_element_spacing_md">8dp</dimen>
    <dimen name="app_element_spacing_lg">12dp</dimen>
    <dimen name="app_element_spacing_xl">16dp</dimen>

    <!-- ── Design Token: Typography — sizes ─────────────────────────────────── -->

    <!--
        label   — section divider text (11sp, letter-spaced, medium weight)
        caption — smallest visible text; reserved notices, helper lines (12sp)
        body    — standard secondary/subtitle text inside cards (13sp)
        title   — primary row title, card headings (16sp)
        heading — prominent card-level headings, e.g. "Task Detail" (18sp)
    -->
    <dimen name="app_text_size_label">11sp</dimen>
    <dimen name="app_text_size_caption">12sp</dimen>
    <dimen name="app_text_size_body">13sp</dimen>
    <dimen name="app_text_size_title">16sp</dimen>
    <dimen name="app_text_size_heading">18sp</dimen>

    <!-- ── Design Token: Typography — micro scale ──────────────────────── -->

    <!-- Smallest visible text — priority slider tick labels (10sp) -->
    <dimen name="app_text_size_micro">10sp</dimen>

    <!-- ── Design Token: Component — specific sizes ─────────────────────── -->

    <!-- Tag / label button width (load factor section) -->
    <dimen name="app_btn_tag">32dp</dimen>

    <!-- ── Design Token: Typography — chevron ───────────────────────────────── -->

    <!-- Navigation indicator rendered as › text character -->
    <dimen name="app_chevron_size">22sp</dimen>

</resources>
