<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions stay at the :app level regardless of which module declares the
         component that uses them — a permission describes what the whole APK needs,
         not which module owns a screen. See feature/src/main/AndroidManifest.xml for
         the Activities/Services/Receivers themselves (moved there in Phase 7). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- External storage for multi-user sync (read/write shared folder)
         API 26-29: READ/WRITE_EXTERNAL_STORAGE for direct file access.
         API 30+  : MANAGE_EXTERNAL_STORAGE bypasses scoped storage; user is
                    prompted in MultiUserSyncActivity; falls back to SAF if denied. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Auto Switch: call detection -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Hover bubble: draw over other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Hover bubble: detect foreground app via UsageStatsManager -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Hover bubble: enumerate all installed apps for the app-picker dialog.
         Required on API 30+ where package visibility is restricted by default. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Hover bubble: foreground service type (API 34) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name="com.eevdf.app.SchedulerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- No components declared here. Every Activity/Service/Receiver lives in
             feature/src/main/AndroidManifest.xml and merges into this <application>
             block at build time via AGP's manifest merger — that's why :app can
             reference @style/AppTheme (feature/ui/res/values/themes.xml) and
             @mipmap/ic_launcher (this module's own res/) in the same tag even
             though they're defined in different modules: :app depends on :feature,
             so :feature's resources are part of :app's final merged resource table. -->

    </application>

</manifest>
